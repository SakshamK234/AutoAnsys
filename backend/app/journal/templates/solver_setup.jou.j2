; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent Solver Setup
; ════════════════════════════════════════════════════════════════════════

; ── Read Mesh ─────────────────────────────────────────────────────────
/file/read-mesh "{{ mesh_file }}"

; ── Print all zones (diagnostic — check slurm output for names) ──────
/report/summary yes

; ── Turbulence Model ─────────────────────────────────────────────────
{% if solver.turbulence.model == "k-omega-sst" %}
/define/models/viscous kw-sst yes
{% elif solver.turbulence.model == "k-epsilon-realizable" %}
/define/models/viscous ke-realizable yes
{% elif solver.turbulence.model == "spalart-allmaras" %}
/define/models/viscous spalart-allmaras yes
{% endif %}

; ── Boundary Conditions (via Scheme for error resilience) ────────────
; ti-menu-load-string won't abort the journal if a zone name is wrong.
; We try multiple common zone-name patterns from the Watertight Workflow.

; --- Inlet (velocity-inlet) ---
{% set v_inlet = solver.boundary_conditions.inlet.velocity %}
{% set ti = solver.boundary_conditions.inlet.turbulent_intensity | default(0.05) %}
{% set tvr = solver.boundary_conditions.inlet.turbulent_viscosity_ratio | default(10) %}
(for-each
  (lambda (name)
    (ti-menu-load-string
      (format #f "/define/boundary-conditions/velocity-inlet ~a no no yes yes no {{ v_inlet }} no 0 no {{ ti }} no {{ tvr }}\n" name)))
  '("inlet" "velocity-inlet-1" "enclosure-inlet" "wt-inlet" "wt_inlet" "inlet-1"))

; --- Outlet (pressure-outlet) ---
{% set p_out = solver.boundary_conditions.outlet.gauge_pressure | default(0) %}
(for-each
  (lambda (name)
    (ti-menu-load-string
      (format #f "/define/boundary-conditions/pressure-outlet ~a yes no {{ p_out }} no yes no no no yes 5 no 10 no yes no no 1\n" name)))
  '("outlet" "pressure-outlet-1" "enclosure-outlet" "wt-outlet" "wt_outlet" "outlet-1"))

; --- Ground — moving wall (freestream velocity along x) ---
{% set v_ground = solver.boundary_conditions.ground.velocity | default(0) %}
(for-each
  (lambda (name)
    (ti-menu-load-string
      (format #f "/define/boundary-conditions/wall ~a 0 no 0 no yes motion-bc-moving yes no no yes {{ v_ground }} 0 0\n" name)))
  '("ground" "wall-enclosure-bottom" "enclosure-bottom" "wt-bottom" "wt_bottom" "floor" "ymin"))

; ── Solution Methods ─────────────────────────────────────────────────
/solve/set/p-v-coupling {{ solver.solution_methods.scheme | default("Coupled") }}
/solve/set/gradient-scheme {{ solver.solution_methods.gradient | default("Least Squares Cell Based") }}
/solve/set/discretization-scheme/pressure {{ solver.solution_methods.pressure | default("Second Order") }}
/solve/set/discretization-scheme/mom {{ solver.solution_methods.momentum | default("Second Order Upwind") }}
/solve/set/discretization-scheme/k {{ solver.solution_methods.turbulent_kinetic_energy | default("Second Order Upwind") }}
{% if solver.turbulence.model == "k-omega-sst" %}
/solve/set/discretization-scheme/omega {{ solver.solution_methods.specific_dissipation_rate | default("Second Order Upwind") }}
{% elif solver.turbulence.model == "k-epsilon-realizable" %}
/solve/set/discretization-scheme/epsilon {{ solver.solution_methods.specific_dissipation_rate | default("Second Order Upwind") }}
{% endif %}

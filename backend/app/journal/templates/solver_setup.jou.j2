; ── Read Mesh ─────────────────────────────────────────────────────────
/file/read-mesh "{{ mesh_file }}"

; ── General Settings ──────────────────────────────────────────────────
; Scale mesh if geometry was in mm (mesh already in SI from mesher)

; ── Turbulence Model ──────────────────────────────────────────────────
{% if solver.turbulence.model == "k-omega-sst" %}
/define/models/viscous kw-sst yes
{% elif solver.turbulence.model == "k-epsilon-realizable" %}
/define/models/viscous ke-realizable yes
{% elif solver.turbulence.model == "spalart-allmaras" %}
/define/models/viscous spalart-allmaras yes
{% endif %}


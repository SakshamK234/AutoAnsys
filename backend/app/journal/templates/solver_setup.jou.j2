; ── Read Case ─────────────────────────────────────────────────────────
/file/read-case "{{ case_file }}"

; ── General Settings ──────────────────────────────────────────────────
/define/models/solver/{{ solver.general.solver_type | default("pressure-based") }}? yes
/define/models/steady? {% if solver.general.time == "transient" %}no{% else %}yes{% endif %}

; ── Turbulence Model ──────────────────────────────────────────────────
{% if solver.turbulence.model == "k-omega-sst" %}
/define/models/viscous/kw-sst? yes
{% elif solver.turbulence.model == "k-epsilon-realizable" %}
/define/models/viscous/ke-realizable? yes
{% elif solver.turbulence.model == "spalart-allmaras" %}
/define/models/viscous/spalart-allmaras? yes
{% endif %}

; ── Boundary Conditions ───────────────────────────────────────────────
; Inlet
/define/boundary-conditions/velocity-inlet inlet no no yes yes no {{ solver.boundary_conditions.inlet.velocity }} no 0 no {{ solver.boundary_conditions.inlet.turbulent_intensity }} no {{ solver.boundary_conditions.inlet.turbulent_viscosity_ratio }}

; Outlet
/define/boundary-conditions/pressure-outlet outlet yes no {{ solver.boundary_conditions.outlet.gauge_pressure }} no yes no no no yes 5 no 10 no yes no no 1

; Ground — Moving Wall
/define/boundary-conditions/wall ground no no no no no no no yes motion-bc-moving yes no no yes {{ solver.boundary_conditions.ground.velocity }} 0 0

; ── Solution Methods ──────────────────────────────────────────────────
/solve/set/p-v-coupling {{ solver.solution_methods.scheme | default("Coupled") | lower }}
/solve/set/gradient-scheme {{ solver.solution_methods.gradient | default("least-squares-cell-based") | replace(" ", "-") | lower }}
/solve/set/discretization-scheme/pressure {{ solver.solution_methods.pressure | default("second-order") | replace(" ", "-") | lower }}
/solve/set/discretization-scheme/mom {{ solver.solution_methods.momentum | default("second-order-upwind") | replace(" ", "-") | lower }}
/solve/set/discretization-scheme/k {{ solver.solution_methods.turbulent_kinetic_energy | default("second-order-upwind") | replace(" ", "-") | lower }}
/solve/set/discretization-scheme/omega {{ solver.solution_methods.specific_dissipation_rate | default("second-order-upwind") | replace(" ", "-") | lower }}

; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent FAULT-TOLERANT (surface-wrapped) MESH
; ANSYS 2025R1 — for DIRTY multi-body full-car assemblies (AUDIT C11).
;
; ┌─────────────────────────────────────────────────────────────────────┐
; │  [needs-cluster] UNVALIDATED SKELETON.                               │
; │  Unlike the Watertight templates (which encode the team's working    │
; │  ARC flow), this Fault-tolerant journal has NOT been run on a real    │
; │  cluster. The task sequence follows the documented 2025R1 FT-Meshing  │
; │  workflow, but the per-task set_state arguments must be validated and  │
; │  corrected against a real ARC session before production use. This is   │
; │  the #1 human-in-the-loop validation item (see VALIDATION.md).        │
; └─────────────────────────────────────────────────────────────────────┘
;
; FT meshing surface-wraps the input, so it tolerates gaps / overlaps / non-
; watertight bodies that the Watertight workflow rejects — the right choice for
; STEP exports of a whole car. Produces the same mesh.cas.h5 artifact the solver
; jobs consume, so nothing downstream changes between workflows.
; ════════════════════════════════════════════════════════════════════════

; ── Initialize Fault-tolerant Meshing Workflow ───────────────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Fault-tolerant Meshing')")

; ── 1. Import CAD and Part Management ────────────────────────────────
; FT uses 'Import CAD and Part Management' (not Watertight's 'Import Geometry').
(%py-exec "workflow.TaskObject['Import CAD and Part Management'].Arguments.set_state({'FileLoaded': r'yes', 'Context': 0, 'CreateObjectPer': r'Custom', 'FileName': r'{{ geometry_file }}', 'LengthUnit': r'{{ mesh.geometry_unit | default("mm") }}'})")
(%py-exec "workflow.TaskObject['Import CAD and Part Management'].Execute()")

; ── 2. Describe Geometry and Flow ────────────────────────────────────
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].Arguments.set_state({'AddEnclosure': r'{{ 'Yes' if mesh.build_enclosure | default(false) else 'No' }}', 'CloseCaps': r'Yes', 'FlowType': r'Internal flow through the object'})")
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].UpdateChildTasks(SetupTypeChanged=False)")
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].Execute()")

; ── 3. Enclose Fluid Region (Capping) ────────────────────────────────
; Caps inlet/outlet/symmetry openings so the wrap produces a closed fluid volume.
; [needs-cluster] cap names must map to the SOP zone labels (inlet/outlet/symmetry).
{% for zone in mesh.original_zones | default(["inlet", "outlet", "symmetry"]) %}
(%py-exec "workflow.TaskObject['Enclose Fluid Region (Capping)'].Arguments.set_state({'PatchName': r'{{ zone }}', 'ZoneType': r'velocity-inlet', 'CreatePatchPreferences': {'ShowCreatePatchPreferences': False}})")
(%py-exec "workflow.TaskObject['Enclose Fluid Region (Capping)'].AddChildAndUpdate()")
{% endfor %}

; ── 4. Extract Edge Features ─────────────────────────────────────────
(%py-exec "workflow.TaskObject['Extract Edge Features'].Arguments.set_state({'ExtractMethodType': r'Intersection Loops', 'SelectionType': r'zone'})")
(%py-exec "workflow.TaskObject['Extract Edge Features'].AddChildAndUpdate()")

; ── 5. Identify Regions (fluid material point) ───────────────────────
; [needs-cluster] the material point must sit INSIDE the fluid domain; the (0,0,0)
; default is a placeholder — set from the enclosure centroid on the cluster.
(%py-exec "workflow.TaskObject['Identify Regions'].Arguments.set_state({'SelectionType': r'zone', 'NewRegionType': r'fluid', 'MaterialPointsName': r'fluid-point', 'X': 0.0, 'Y': 0.0, 'Z': 0.0})")
(%py-exec "workflow.TaskObject['Identify Regions'].AddChildAndUpdate()")

; ── 6. Define Leakage Threshold ──────────────────────────────────────
(%py-exec "workflow.TaskObject['Define Leakage Threshold'].Arguments.set_state({'RegionSelectionSingle': r'fluid-point', 'DeadRegionsName': r'none'})")
(%py-exec "workflow.TaskObject['Define Leakage Threshold'].AddChildAndUpdate()")

; ── 7. Choose Mesh Control Options (surface sizing) ──────────────────
(%py-exec "workflow.TaskObject['Choose Mesh Control Options'].Execute()")

; ── 8. Generate the Surface Mesh (wrap) ──────────────────────────────
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Arguments.set_state({'CFDSurfaceMeshControls': {'MinSize': {{ mesh.surface_mesh.min_size }}, 'MaxSize': {{ mesh.surface_mesh.max_size }}, 'GrowthRate': {{ mesh.surface_mesh.growth_rate }}, 'CurvatureNormalAngle': {{ mesh.surface_mesh.curvature_normal_angle }}}})")
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")

; ── 9. Update Region Settings ────────────────────────────────────────
(%py-exec "workflow.TaskObject['Update Region Settings'].Execute()")

; ── 10. Add Boundary Layers (prism, count from config — AUDIT C6) ────
; F9: optional FirstHeight for a wall-resolved y+ ≈ 1 first cell.
(%py-exec "workflow.TaskObject['Add Boundary Layers'].Arguments.set_state({'LocalPrismPreferences': {'Continuous': r'Continuous'}, 'OffsetMethodType': r'last-ratio', 'NumberOfLayers': {{ mesh.volume_mesh.num_layers | default(15) }}{% if mesh.volume_mesh.first_layer_height_mm %}, 'FirstHeight': {{ mesh.volume_mesh.first_layer_height_mm }}{% endif %}})")
(%py-exec "workflow.TaskObject['Add Boundary Layers'].AddChildAndUpdate(DeferUpdate=False)")

; ── 11. Generate the Volume Mesh (poly-hexcore) ──────────────────────
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Arguments.set_state({'VolumeFill': r'poly-hexcore'})")
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")

; ══════════════════════════════════════════════════════════════════════
; Persist the mesh as a solver-readable case file (same artifact contract as
; the Watertight path).
; ══════════════════════════════════════════════════════════════════════
switch-to-solution-mode
yes

(%py-exec "print('=== MESH ZONE LIST ===')")
/define/boundary-conditions/list-zones

/file/write-case "{{ workspace }}/mesh.cas.h5"

(%py-exec "print('=== MESH_CELL_COUNT_BEGIN ===')")
/mesh/size-info
(%py-exec "print('=== MESH_CELL_COUNT_END ===')")

/exit yes

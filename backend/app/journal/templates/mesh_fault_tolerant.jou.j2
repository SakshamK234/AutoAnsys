; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent FAULT-TOLERANT / VIRTUAL WIND TUNNEL mesh
; ANSYS 2025R1 — for multi-body assemblies and enclosure-carrying exports.
;
; This sequence was PROVEN LIVE on ARC TinkerCliffs (probes 6372187→6378056,
; see docs/CLUSTER_FINDINGS.md): import via PartManagement, ModelingObjective
; 'Virtual Wind Tunnel', Create External Flow Boundaries on the geometry's own
; enclosure body, fluid material point at the enclosure centroid, custom scoped
; sizing + size field, wrap → prisms → hexcore, write mesh.cas.h5.
;
; Requirements on the input CAD (matches the team's SOP exports):
;   • contains the part body/bodies AND an enclosure/bounding-box body
;     (Fluent objects arrive as e.g. ['enclosure', 'geom']);
;   • face labels are NOT required (unlabeled faces are wrapped).
; [needs-cluster] the final wrap→volume stage at production sizing is being
; validated (probe27); boundary naming of the tunnel faces comes from its zone
; list and feeds the solver BC template.
; ════════════════════════════════════════════════════════════════════════

; ── Initialize Fault-tolerant Meshing + register the CAD ─────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Fault-tolerant Meshing')")
(%py-exec "PartManagement.InputFileChanged(FilePath=r'{{ geometry_file }}', IgnoreSolidNames=False, PartPerBody=False)")
(%py-exec "PMFileManagement.FileManager.LoadFiles()")
(%py-exec "workflow.TaskObject['Import CAD and Part Management'].Execute()")
(display "IMPORT_DONE")(newline)

; ── Describe Geometry and Flow: Virtual Wind Tunnel objective ────────
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].Arguments.set_state({'ModelingObjective': r'Virtual Wind Tunnel'})")
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].Execute()")
(display "DGF_DONE")(newline)

; ── External flow boundaries from the geometry's own enclosure body ──
; Self-healing object pick: after import the objects are e.g.
; ['enclosure','geom']; CEFB renames the box to 'tunnel' on execute.
(%py-exec "objs = meshing_utilities.get_objects(filter=r'*')")
(%py-exec "print('OBJECTS:', objs)")
(%py-exec "encl = ([o for o in objs if str(o).lower() in ('enclosure','tunnel','box','bounding_box','boundingbox')] or [o for o in objs if str(o).lower() != 'geom'])[0]")
(%py-exec "body = ([o for o in objs if str(o).lower() not in (str(encl).lower(), 'tunnel')] or objs)[0]")
(%py-exec "print('ENCLOSURE_OBJECT:', encl, 'BODY_OBJECT:', body)")
(%py-exec "workflow.TaskObject['Create External Flow Boundaries'].Arguments.set_state({'CreationMethod': r'Use existing boundary', 'SelectionType': r'object', 'ObjectSelectionSingle': [encl], 'ExtractionMethod': r'surface mesh'})")
(%py-exec "workflow.TaskObject['Create External Flow Boundaries'].Execute()")
(display "CEFB_DONE")(newline)

; ── Fluid region: material point at the tunnel centroid ──────────────
; The SOP enclosure is asymmetric (long wake), so its centroid sits in open
; fluid. CEFB renamed the box object to 'tunnel' — requery before selecting.
(%py-exec "objs2 = meshing_utilities.get_objects(filter=r'*')")
(%py-exec "mp = ([o for o in objs2 if str(o).lower() in ('tunnel','enclosure')] or [o for o in objs2 if str(o).lower() != str(body).lower()])[0]")
(%py-exec "workflow.TaskObject['Identify Regions'].Arguments.set_state({'AddChild': r'yes', 'MaterialPointsName': r'tunnel-fluid', 'MptMethodType': r'Centroid of Objects', 'NewRegionType': r'fluid', 'SelectionType': r'object', 'ObjectSelectionList': [mp]})")
(%py-exec "workflow.TaskObject['Identify Regions'].AddChildAndUpdate(DeferUpdate=False)")
(display "IDREG_DONE")(newline)

; ── Region settings (body → void, tunnel-fluid → fluid/hexcore/wrap) ─
(%py-exec "workflow.TaskObject['Update Region Settings'].Execute()")
(display "URS_DONE")(newline)

; ── Global + scoped sizing, then compute the size field ──────────────
; Sizes are in METERS (the import converts from {{ mesh.geometry_unit | default("mm") }}).
{% set sm = mesh.surface_mesh %}
{% set gmin_m = (sm.min_size | default(2.0)) / 1000.0 %}
{% set gmax_m = (sm.max_size | default(264.0)) / 1000.0 %}
(%py-exec "workflow.TaskObject['Choose Mesh Control Options'].Arguments.set_state({'ReadOrCreate': r'Create new', 'CreationMethod': r'Custom', 'GlobalMin': {{ gmin_m }}, 'GlobalMax': {{ gmax_m }}, 'GlobalGrowthRate': {{ sm.growth_rate | default(1.2) }}})")
(%py-exec "workflow.TaskObject['Choose Mesh Control Options'].Execute()")
(display "CMCO_DONE")(newline)
; Curvature control scoped to the part body (local max = global max / 5, a
; proven-on-ARC default that resolves thin wing elements).
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({'LocalSettingsName': r'body-curvature', 'SelectionType': r'object', 'ObjectSelectionList': [body], 'LocalSizeControlParameters': {'SizingType': r'curvature', 'MinSize': {{ gmin_m }}, 'MaxSize': {{ (gmax_m / 5.0) | round(4) }}, 'GrowthRate': {{ sm.growth_rate | default(1.2) }}, 'CurvatureNormalAngle': {{ sm.curvature_normal_angle | default(18.0) }}}})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
{% for region in mesh.local_sizing %}
{% if region.type == "body_of_influence" %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({'LocalSettingsName': r'{{ region.name }}', 'SelectionType': r'object', 'ObjectSelectionList': [body], 'LocalSizeControlParameters': {'SizingType': r'boi', 'MaxSize': {{ region.size }}, 'GrowthRate': {{ region.growth_rate }}}})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
{% endif %}
{% endfor %}
(display "ALS_DONE")(newline)
(%py-exec "workflow.TaskObject['Compute Size Field(s)'].Arguments.set_state({'ComputeSizeFieldControl': r'yes'})")
(%py-exec "workflow.TaskObject['Compute Size Field(s)'].Execute()")
(display "CSF_DONE")(newline)

; ── Wrap → regions → boundaries → prisms → volume ─────────────────────
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")
(display "SURF_DONE")(newline)
(%py-exec "workflow.TaskObject['Compute Regions'].Execute()")
(%py-exec "workflow.TaskObject['Update Boundaries'].Execute()")
(%py-exec "workflow.TaskObject['Update Region Settings'].Execute()")
(display "REGIONS_DONE")(newline)
(%py-exec "workflow.TaskObject['Generate Boundary Layers'].Execute()")
(display "PRISMS_DONE")(newline)
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")
(display "VOLUME_DONE")(newline)

; ══════════════════════════════════════════════════════════════════════
; Persist the mesh as a solver-readable case file (same artifact contract as
; the Watertight path).
; ══════════════════════════════════════════════════════════════════════
switch-to-solution-mode
yes

(display "=== MESH ZONE LIST ===")(newline)
/define/boundary-conditions/list-zones

/file/write-case "{{ workspace }}/mesh.cas.h5"

(display "=== MESH_CELL_COUNT_BEGIN ===")(newline)
/mesh/size-info
(display "=== MESH_CELL_COUNT_END ===")(newline)

/exit yes

; ════════════════════════════════════════════════════════════════════════
; FT WRAP — COMPONENT BOUNDARY CLASSIFIER (fc28 flat-at-extreme logic)
; Included by mesh_fault_tolerant.jou.j2 when classify_boundaries is set and
; NO carve_domain is configured — a single part / sub-assembly that FLOATS
; inside the tunnel box (does not touch the ground). Unlike the full-car
; case, the ground is a clean box face (no wheel-contact fusion), so there
; is no slab carve.
;
; Method (the fc28 classifier, minus the ground fusion + carve): each tunnel
; box face is FLAT in one axis and sits AT a domain extreme — inlet (x-max) /
; outlet (x-min) / ground (z-min) / farfield-top (z-max) / symmetry (y-min,
; the half-model cut) / farfield-side (y-max). Multiple wrapped zones may
; share a face; they all take that name and merge. Everything not at an
; extreme is the part body → merged into 'body'. Robust because it keys on
; geometric position, not zone count or naming (probe33's thin-axis + 6-
; largest heuristic misclassified this wrap: comp val job 6415018).
; ════════════════════════════════════════════════════════════════════════

(display "CLASSIFY_BEGIN")(newline)
(%py-exec "allz = [int(z) for z in meshing_utilities.get_face_zones(filter=r'*')]")
(%py-exec "interior = set(int(z) for z in meshing_utilities.get_face_zones(filter=r'interior*'))")
(%py-exec "meshz = [z for z in allz if z not in interior]")
(%py-exec "print('MESH_FACE_ZONES:', len(meshz), 'of', len(allz))")
(%py-exec "bbs = {z: meshing_utilities.get_bounding_box_of_zone_list(zone_id_list=[z]) for z in meshz}")
(%py-exec "xmin = min(b[0][0] for b in bbs.values()); xmax = max(b[1][0] for b in bbs.values()); ymin = min(b[0][1] for b in bbs.values()); ymax = max(b[1][1] for b in bbs.values()); zmin = min(b[0][2] for b in bbs.values()); zmax = max(b[1][2] for b in bbs.values())")
(%py-exec "print('DOMAIN_EXTENTS_m:', [[xmin,ymin,zmin],[xmax,ymax,zmax]])")
(%py-exec "tol = 0.004 * max(xmax - xmin, ymax - ymin, zmax - zmin)")
(%py-exec "def flat(z, i): return (bbs[z][1][i] - bbs[z][0][i]) < tol")
(%py-exec "def at(z, i, v): return abs(bbs[z][0][i] - v) < tol and abs(bbs[z][1][i] - v) < tol")
(%py-exec "names = {}")
(%py-exec "[names.__setitem__(z, 'inlet') for z in meshz if flat(z, 0) and at(z, 0, xmax)]")
(%py-exec "[names.__setitem__(z, 'outlet') for z in meshz if flat(z, 0) and at(z, 0, xmin)]")
(%py-exec "[names.__setitem__(z, 'ground') for z in meshz if flat(z, 2) and at(z, 2, zmin)]")
(%py-exec "[names.__setitem__(z, 'farfield-top') for z in meshz if flat(z, 2) and at(z, 2, zmax)]")
(%py-exec "[names.__setitem__(z, 'symmetry') for z in meshz if flat(z, 1) and at(z, 1, ymin)]")
(%py-exec "[names.__setitem__(z, 'farfield-side') for z in meshz if flat(z, 1) and at(z, 1, ymax)]")
(%py-exec "print('ASSIGNED:', {n: sum(1 for v in names.values() if v == n) for n in set(names.values())})")
(%py-exec "assert sorted(set(names.values())) == ['farfield-side', 'farfield-top', 'ground', 'inlet', 'outlet', 'symmetry'], 'component classifier missing box faces: ' + str(sorted(set(names.values())))")
(%py-exec "body = sorted(z for z in meshz if z not in names)")
(%py-exec "print('BODY_ZONES:', len(body))")
(%py-exec "assert body, 'no body zones left after classifying the box faces'")
(%py-exec "groups = {n: sorted(z for z, v in names.items() if v == n) for n in set(names.values())}")
(%py-exec "groups['body'] = body")
; MERGE STRATEGY (v4, after two dead ends — jobs 6415334/6415527/6417436):
; ids do NOT survive switch-to-solution-mode (low CAD ids get renumbered) but
; NAMES do; and meshing-mode merge cannot cross mesh objects while solver-mode
; merge can. So: give every fragment a UNIQUE name here in meshing mode
; (rename_face_zone is proven safe), then merge BY NAME in solver mode via the
; assign.scm. Fragment lists are ascending-id; the merge survivor keeps the
; lowest id (fc28 evidence), so the '<group>-1' fragment is renamed to the
; final group name after each merge.
(%py-exec "ren = {}")
(%py-exec "[ren.__setitem__(z, n + '-' + str(i + 1)) for n, zs in groups.items() for i, z in enumerate(zs)]")
(%py-exec "[meshing_utilities.rename_face_zone(zone_id=int(z), new_name=nm) for z, nm in ren.items()]")
(%py-exec "print('RENAMED', len(ren), 'fragments across', len(groups), 'groups')")
; Zone-name ARGUMENTS in modify-zones prompts are SCHEME-EVALUATED: numeric
; ids self-evaluate (why id-based merges always worked) but bare names parse
; as unbound symbols ("eval: unbound variable body-1", job 6442835). Names
; must be written as escaped quoted strings inside the ti-menu string.
(%py-exec "f = open(r'{{ workspace }}/assign.scm', 'w')")
(%py-exec "q = chr(34); nl = chr(10); eq = chr(92) + chr(34)")
(%py-exec "[f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/merge-zones ' + ' '.join(eq + n + '-' + str(i + 1) + eq for i in range(len(zs))) + ' ()' + q + ')' + nl) for n, zs in sorted(groups.items()) if len(zs) > 1]")
(%py-exec "[f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/zone-name ' + eq + n + '-1' + eq + ' ' + eq + n + eq + q + ')' + nl) for n, zs in sorted(groups.items())]")
(%py-exec "f.close()")
(display "CLASSIFIER_DONE")(newline)

switch-to-solution-mode
yes

(load "{{ workspace }}/assign.scm")
(display "ASSIGN_LOADED")(newline)

; Pin flow-boundary zone TYPES into the mesh so the shared solver BC block
; only has to set VALUES (ground / farfield / body stay the default wall type).
/define/boundary-conditions/zone-type inlet velocity-inlet
/define/boundary-conditions/zone-type outlet pressure-outlet
/define/boundary-conditions/zone-type symmetry symmetry
(display "ZONE_TYPES_PINNED")(newline)

; ════════════════════════════════════════════════════════════════════════
; FT WRAP — COMPONENT BOUNDARY CLASSIFIER (probe33, wing-validated)
; Included by mesh_fault_tolerant.jou.j2 when classify_boundaries is set and
; NO carve_domain is configured — i.e. a single part / sub-assembly that
; FLOATS inside the tunnel box (does not touch the ground). Unlike the
; full-car case, the six box faces come out as clean separate zones and the
; body never fuses with the ground, so there is no slab carve.
;
; Method (probe33, job 6380198): the six LARGEST face zones are the tunnel
; box; everything else is the part body. Each box face is named by its thin
; axis + position — inlet (x nearer the body) / outlet (x far) / ground
; (z-min) / farfield-top (z-max) / symmetry (y-min, the half-model cut) /
; farfield-side (y-max). The body zones merge into 'body'. The rename scheme
; is written to a file and loaded after the mode switch (merge-zones /
; zone-name are solution-mode ops).
; ════════════════════════════════════════════════════════════════════════

(display "CLASSIFY_BEGIN")(newline)
(%py-exec "allz = [int(z) for z in meshing_utilities.get_face_zones(filter=r'*')]")
(%py-exec "interior = set(int(z) for z in meshing_utilities.get_face_zones(filter=r'interior*'))")
(%py-exec "meshz = [z for z in allz if z not in interior]")
(%py-exec "print('MESH_FACE_ZONES:', len(meshz), 'of', len(allz))")
(%py-exec "amap = {z: float(meshing_utilities.get_face_zone_area(face_zone_id_list=[z])) for z in meshz}")
(%py-exec "big = sorted(amap, key=lambda z: -amap[z])[:6]")
(%py-exec "body = [z for z in meshz if z not in big]")
(%py-exec "print('BOX_FACES:', big, 'BODY_ZONES:', body)")
(%py-exec "assert len(big) == 6, 'expected 6 tunnel box faces, got ' + str(len(big))")
(%py-exec "assert body, 'no body zones left after removing the 6 box faces'")
(%py-exec "E = {z: meshing_utilities.get_bounding_box_of_zone_list(zone_id_list=[z]) for z in big}")
(%py-exec "xmin = min(E[z][0][0] for z in big); xmax = max(E[z][1][0] for z in big)")
(%py-exec "def span(z, i): return E[z][1][i] - E[z][0][i]")
(%py-exec "def thin_axis(z): d = [span(z, 0), span(z, 1), span(z, 2)]; return d.index(min(d))")
(%py-exec "def ctr(z, i): return 0.5 * (E[z][0][i] + E[z][1][i])")
; Body centroid (x) decides which x-face is the inlet (the nearer one).
(%py-exec "bE = {z: meshing_utilities.get_bounding_box_of_zone_list(zone_id_list=[z]) for z in body}")
(%py-exec "bcx = 0.5 * (min(bE[z][0][0] for z in body) + max(bE[z][1][0] for z in body))")
(%py-exec "xf = sorted([z for z in big if thin_axis(z) == 0], key=lambda z: ctr(z, 0))")
(%py-exec "yf = sorted([z for z in big if thin_axis(z) == 1], key=lambda z: ctr(z, 1))")
(%py-exec "zf = sorted([z for z in big if thin_axis(z) == 2], key=lambda z: ctr(z, 2))")
(%py-exec "assert len(xf) == 2 and len(yf) == 2 and len(zf) == 2, 'box faces not 2 per axis: x=' + str(xf) + ' y=' + str(yf) + ' z=' + str(zf)")
(%py-exec "names = {}")
(%py-exec "names[xf[0]] = 'inlet' if abs(bcx - ctr(xf[0], 0)) < abs(bcx - ctr(xf[1], 0)) else 'outlet'")
(%py-exec "names[xf[1]] = 'outlet' if names[xf[0]] == 'inlet' else 'inlet'")
(%py-exec "names[zf[0]] = 'ground'; names[zf[1]] = 'farfield-top'")
(%py-exec "names[yf[0]] = 'symmetry'; names[yf[1]] = 'farfield-side'")
(%py-exec "print('ASSIGNED:', {z: names[z] for z in big})")
(%py-exec "assert sorted(names.values()) == ['farfield-side', 'farfield-top', 'ground', 'inlet', 'outlet', 'symmetry'], 'component classifier names: ' + str(sorted(names.values()))")
(%py-exec "f = open(r'{{ workspace }}/assign.scm', 'w')")
(%py-exec "q = chr(34); nl = chr(10)")
(%py-exec "[f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/zone-name ' + str(z) + ' ' + names[z] + q + ')' + nl) for z in big]")
(%py-exec "f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/merge-zones ' + ' '.join(str(z) for z in body) + ' ()' + q + ')' + nl) if len(body) > 1 else None")
(%py-exec "f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/zone-name ' + str(body[0]) + ' body' + q + ')' + nl)")
(%py-exec "f.close()")
(display "CLASSIFIER_DONE")(newline)

switch-to-solution-mode
yes

(load "{{ workspace }}/assign.scm")
(display "ASSIGN_LOADED")(newline)

; Pin flow-boundary zone TYPES into the mesh so the shared solver BC block
; only has to set VALUES (ground / farfield / body stay the default wall type).
/define/boundary-conditions/zone-type inlet velocity-inlet
/define/boundary-conditions/zone-type outlet pressure-outlet
/define/boundary-conditions/zone-type symmetry symmetry
(display "ZONE_TYPES_PINNED")(newline)

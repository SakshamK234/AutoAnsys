; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent Watertight Geometry + Solver
; Single-session: mesh in meshing mode → switch-to-solution-mode → solve
; ANSYS 2025R1 — (%py-exec ...) Python workflow API
;
; Follows the team SOPs:
;   - CFD_SOP (Individual Part)   → cfd_mode = "individual_part"
;   - Kevin Full Car Reference    → cfd_mode = "full_car"
; ════════════════════════════════════════════════════════════════════════

; ══════════════════════════════════════════════════════════════════════
; PHASE 1: MESHING
; ══════════════════════════════════════════════════════════════════════

; ── Initialize Watertight Geometry Workflow ───────────────────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Watertight Geometry')")

; ── 1. Import Geometry ───────────────────────────────────────────────
; OneZonePer='body' — robust default for 2025R1. 'label' is rejected
; ("Invalid Input label") and 'face' creates per-face zones that segfault
; Update Regions ("> invalid argument: not a number") on car-scale
; geometries. Discovery face labels survive as CAD face labels on the body;
; Update Boundaries below uses original_zones to map them to the SOP zone
; names (inlet / outlet / ground / symmetry / walls).
; NOTE: SaveFacetedFile was removed from CadImportOptions in 2025R1
;       ("Illegitimate input at /ImportGeometry/CadImportOptions").
(%py-exec "workflow.TaskObject['Import Geometry'].Arguments.set_state({'FileName': r'{{ geometry_file }}', 'LengthUnit': r'{{ mesh.geometry_unit | default("mm") }}', 'CadImportOptions': {'OneZonePer': r'body', 'FeatureAngle': 40.0, 'ExtractFeatures': r'yes'}, 'ImportCadPreferences': {'ShowImportCadPreferences': False, 'MaxFacetLength': 0}})")
(%py-exec "workflow.TaskObject['Import Geometry'].Execute()")

; ── 2. Add Local Sizing ──────────────────────────────────────────────
; SOP local-sizing categories: aero / chassis / wheels / intake
; SOP local-refinement regions:  nearfield / farfield / rear_wing
{% for region in mesh.local_sizing %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate()")
{% if region.type == "body_of_influence" %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({'AddChild': r'yes', 'BOIControlName': r'{{ region.name }}', 'BOIExecution': r'Body Of Influence', 'BOISize': {{ region.size }}, 'BOIGrowthRate': {{ region.growth_rate }}})")
{% else %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({'AddChild': r'yes', 'BOIControlName': r'{{ region.name }}', 'BOIExecution': r'Face Size', 'BOISize': {{ region.size }}, 'BOIGrowthRate': {{ region.growth_rate }}, 'BOIFaceLabelList': [{% for face in region.face_zones %}r'{{ face }}'{% if not loop.last %}, {% endif %}{% endfor %}]})")
{% endif %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Execute()")
{% endfor %}

; ── 3. Generate Surface Mesh ─────────────────────────────────────────
; Reference journal (SOP): ExecuteShareTopology='No', DrawSizeControl=False,
; ScopeProximityTo='faces-and-edges', OriginalZones listed explicitly.
; The SOP CAD is exported from Discovery with the enclosure already built and
; faces labeled (inlet / outlet / ground / symmetry / walls / aero components),
; so Fluent does NOT need to cap or share-topology.
{% set original_zones = mesh.original_zones | default(["inlet", "outlet", "ground", "symmetry", "walls"]) %}
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Arguments.set_state({'CFDSurfaceMeshControls': {'DrawSizeControl': False, 'MinSize': {{ mesh.surface_mesh.min_size }}, 'MaxSize': {{ mesh.surface_mesh.max_size }}, 'GrowthRate': {{ mesh.surface_mesh.growth_rate }}, 'CurvatureNormalAngle': {{ mesh.surface_mesh.curvature_normal_angle }}, 'ScopeProximityTo': r'faces-and-edges'}, 'ExecuteShareTopology': r'No', 'OriginalZones': [{% for z in original_zones %}r'{{ z }}'{% if not loop.last %}, {% endif %}{% endfor %}]})")
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")

; ── 3b. Improve Surface Mesh (SOP FaceQualityLimit 0.6, wall-zones scope) ─
; Improve Surface Mesh is NOT a built-in Watertight task — must be inserted
; after Generate Surface Mesh before TaskObject[...] can reference it.
{% set mq = mesh.mesh_quality | default({}) %}
{% if mq.get('auto_improve', True) %}
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].InsertNextTask(CommandName='ImproveSurfaceMesh')")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Arguments.set_state({'FaceQualityLimit': {{ mq.get('surface_skewness_threshold', 0.6) }}, 'MeshObject': r'', 'SMImprovePreferences': {'AdvancedImprove': r'no', 'AllowDefeaturing': r'no', 'SIQualityCollapseLimit': 0.85, 'SIQualityIterations': 5, 'SIQualityMaxAngle': 160, 'SIRemoveStep': r'no', 'SIStepQualityLimit': 0, 'SIStepWidth': 0, 'ShowSMImprovePreferences': False}, 'SQMinSize': {{ mesh.surface_mesh.min_size }}, 'ScopeImproveTo': r'wall-zones'})")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Execute()")
{% endif %}

; ── 4. Describe Geometry ─────────────────────────────────────────────
; Reference journal: defaults + UpdateChildTasks({v1: True}, SetupTypeChanged=False).
; The SOP CAD already contains the enclosure, so the default SetupType is correct
; and we do NOT override it here.
(%py-exec "workflow.TaskObject['Describe Geometry'].UpdateChildTasks(Arguments={'v1': True}, SetupTypeChanged=False)")
(%py-exec "workflow.TaskObject['Describe Geometry'].Execute()")

; ── 5. Update Boundaries ─────────────────────────────────────────────
; Reference: set_state(None) then Execute — picks up the Discovery-applied labels.
(%py-exec "workflow.TaskObject['Update Boundaries'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Boundaries'].Execute()")

; ── 6. Update Regions ────────────────────────────────────────────────
(%py-exec "workflow.TaskObject['Update Regions'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Regions'].Execute()")

; ── 7. Add Boundary Layers ──────────────────────────────────────────
; SOP: last-ratio offset method with Continuous local-prism preference.
; Setting OffsetMethodType='last-ratio' before AddChildAndUpdate makes the
; spawned child task be named 'last-ratio_1' (default would be 'smooth-transition_1').
(%py-exec "workflow.TaskObject['Add Boundary Layers'].Arguments.set_state({'LocalPrismPreferences': {'Continuous': r'Continuous'}, 'OffsetMethodType': r'last-ratio'})")
(%py-exec "workflow.TaskObject['Add Boundary Layers'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['last-ratio_1'].Execute()")

; ── 8. Generate Volume Mesh ──────────────────────────────────────────
; Reference: no custom args, uses Watertight defaults.
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")

; ── 8b. Improve Volume Mesh (SOP ortho-quality threshold 0.15) ───────
; Same pattern — must be inserted before reference.
{% if mq.get('auto_improve', True) %}
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].InsertNextTask(CommandName='ImproveVolumeMesh')")
(%py-exec "workflow.TaskObject['Improve Volume Mesh'].Execute()")
{% endif %}

; ══════════════════════════════════════════════════════════════════════
; TRANSITION: Switch from meshing mode to solver mode
; The mesh stays in memory — no file write/read needed
; ══════════════════════════════════════════════════════════════════════
switch-to-solution-mode
yes

; ══════════════════════════════════════════════════════════════════════
; PHASE 2: SOLVER SETUP
; ══════════════════════════════════════════════════════════════════════

; ── Print zone list for debugging ─────────────────────────────────────
; Zones come from Discovery-applied face labels on the Parasolid export.
; Expected: inlet, outlet, ground, symmetry, walls (+ aero components for full car).
(%py-exec "print('=== ZONE LIST ===')")
/define/boundary-conditions/list-zones

; ── Safety net: force enclosure cell zone to fluid ────────────────────
; If Discovery exported the enclosure as a solid body, flip it here.
; (If it's already fluid, Fluent will no-op or complain harmlessly.)
/define/boundary-conditions/zone-type enclosure fluid

; ── Reference values, turbulence model, all BCs (shared partial) ─────
{% include '_bc_block.jou.j2' %}

; ── Solution Methods ──────────────────────────────────────────────────
/solve/set/p-v-coupling {{ solver.solution_methods.scheme | default("Coupled") }}
/solve/set/gradient-scheme {{ solver.solution_methods.gradient | default("Least Squares Cell Based") }}
/solve/set/discretization-scheme/pressure {{ solver.solution_methods.pressure | default("Second Order") }}
/solve/set/discretization-scheme/mom {{ solver.solution_methods.momentum | default("Second Order Upwind") }}
/solve/set/discretization-scheme/k {{ solver.solution_methods.turbulent_kinetic_energy | default("Second Order Upwind") }}
{% if solver.turbulence.model == "k-omega-sst" %}
/solve/set/discretization-scheme/omega {{ solver.solution_methods.specific_dissipation_rate | default("Second Order Upwind") }}
{% elif solver.turbulence.model == "k-epsilon-realizable" %}
/solve/set/discretization-scheme/epsilon {{ solver.solution_methods.specific_dissipation_rate | default("Second Order Upwind") }}
{% endif %}

; ══════════════════════════════════════════════════════════════════════
; PHASE 3: SOLVER RUN
; ══════════════════════════════════════════════════════════════════════

; ── Report Definitions ────────────────────────────────────────────────
/solve/report-definitions/add cd force force-vector 1 0 0 thread-names * () quit
/solve/report-definitions/add cl force force-vector 0 0 1 thread-names * () quit
/solve/report-definitions/add cm moment moment-vector 0 1 0 moment-center 0 0 0 thread-names * () quit

; ── Report Files ──────────────────────────────────────────────────────
/solve/report-files/add forces-report report-defs cd cl cm () file-name "{{ workspace }}/forces.csv" print? yes quit
/solve/report-files/add residuals-report report-type iteration file-name "{{ workspace }}/residuals.csv" print? yes quit

; ── Convergence Monitors ──────────────────────────────────────────────
/solve/monitors/residual/convergence-criteria {{ solver.convergence.residual_target | default(1e-4) }} {{ solver.convergence.residual_target | default(1e-4) }} {{ solver.convergence.residual_target | default(1e-4) }} {{ solver.convergence.residual_target | default(1e-4) }} {{ solver.convergence.residual_target | default(1e-4) }} {{ solver.convergence.residual_target | default(1e-4) }}

; ── Initialize ────────────────────────────────────────────────────────
{% if solver.initialization | default("hybrid") == "hybrid-absolute" %}
/solve/initialize/set-hyb-initialization/reference-frame absolute
/solve/initialize/hyb-initialization yes
{% else %}
/solve/init/hyb-init
{% endif %}

; ── Save case file before iterating (SOP step) ────────────────────────
/file/write-case "{{ workspace }}/result.cas.h5"

; ── Run (SOP: individual part 300, full car 3000) ─────────────────────
/solve/iterate {{ solver.convergence.max_iterations | default(300) }}

; ── Export Results ────────────────────────────────────────────────────
{% if solver.data_export.case_data | default(true) %}
/file/write-case-data "{{ workspace }}/result.cas.h5"
{% endif %}

; ══════════════════════════════════════════════════════════════════════
; PHASE 4: POST-PROCESSING — Contour Images
; ══════════════════════════════════════════════════════════════════════

; ── Picture driver setup (offscreen PNG for batch mode) ─────────────
/display/set/picture/driver png
/display/set/picture/x-resolution 1920
/display/set/picture/y-resolution 1080
/display/set/picture/use-window-resolution no
/display/set/picture/color-mode color

; ── Create mid-plane cross-section for flow field visualization ─────
; Z=0 symmetry plane gives a side-view slice through the domain
(%py-exec "solver.results.surfaces.iso_surface['midplane-z'] = {'field': 'z-coordinate', 'iso_values': [0.0]}")

; ── Velocity magnitude contour (boundary surfaces) ──────────────────
/display/set/contours/filled? yes
/display/set/contours/node-values? yes
/display/set/contours/surfaces {{ inlet_zone }} {{ outlet_zone }} {{ ground_zone }} ()
/display/contour velocity velocity-magnitude
/display/save-picture "{{ workspace }}/contour_velocity.png"

; ── Velocity magnitude on mid-plane (flow field cross-section) ──────
/display/set/contours/surfaces midplane-z ()
/display/contour velocity velocity-magnitude
/display/save-picture "{{ workspace }}/contour_velocity_midplane.png"

; ── Static pressure contour (boundary surfaces) ────────────────────
/display/set/contours/surfaces {{ inlet_zone }} {{ outlet_zone }} {{ ground_zone }} ()
/display/contour pressure static-pressure
/display/save-picture "{{ workspace }}/contour_pressure.png"

; ── Static pressure on mid-plane ───────────────────────────────────
/display/set/contours/surfaces midplane-z ()
/display/contour pressure static-pressure
/display/save-picture "{{ workspace }}/contour_pressure_midplane.png"

; ── Total pressure contour ──────────────────────────────────────────
/display/set/contours/surfaces {{ inlet_zone }} {{ outlet_zone }} {{ ground_zone }} ()
/display/contour pressure total-pressure
/display/save-picture "{{ workspace }}/contour_total_pressure.png"

; ── Pressure coefficient on body surfaces ───────────────────────────
/display/set/contours/surfaces * ()
/display/contour pressure pressure-coefficient
/display/save-picture "{{ workspace }}/contour_cp.png"

; ── Wall shear stress (on body surfaces only) ───────────────────────
/display/contour wall-fluxes wall-shear-stress
/display/save-picture "{{ workspace }}/contour_wall_shear.png"

; ── Turbulent kinetic energy on mid-plane ──────────────────────────
/display/set/contours/surfaces midplane-z ()
/display/contour turb-kinetic-energy k
/display/save-picture "{{ workspace }}/contour_tke_midplane.png"

; ── Done ──────────────────────────────────────────────────────────────
/exit yes

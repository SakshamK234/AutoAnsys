; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent Mesher Watertight Geometry Workflow
; ════════════════════════════════════════════════════════════════════════

; ── Import Geometry ────────────────────────────────────────────────────
/file/import/cad-geometry yes "{{ geometry_file }}" no {{ mesh.geometry_unit | default("mm") }}

; ── Local Sizing ──────────────────────────────────────────────────────
{% for region in mesh.local_sizing %}
/workflow/task/compound-child "Add Local Sizing" "Add Local Sizing"
/workflow/task/compound-child/set "Add Local Sizing" "name" "{{ region.name }}"
{% if region.type == "body_of_influence" %}
/workflow/task/compound-child/set "Add Local Sizing" "type" "body-of-influence"
/workflow/task/compound-child/set "Add Local Sizing" "boi-size" {{ region.size }}
{% else %}
/workflow/task/compound-child/set "Add Local Sizing" "type" "face-size"
/workflow/task/compound-child/set "Add Local Sizing" "face-size" {{ region.size }}
{% for face in region.face_zones %}
/workflow/task/compound-child/set "Add Local Sizing" "face-zone" "{{ face }}"
{% endfor %}
{% endif %}
/workflow/task/compound-child/set "Add Local Sizing" "growth-rate" {{ region.growth_rate }}
/workflow/task/command "Add Local Sizing" "yes"
{% endfor %}

; ── Generate Surface Mesh ─────────────────────────────────────────────
/workflow/task/set "Generate the Surface Mesh" "min-size" {{ mesh.surface_mesh.min_size }}
/workflow/task/set "Generate the Surface Mesh" "max-size" {{ mesh.surface_mesh.max_size }}
/workflow/task/set "Generate the Surface Mesh" "growth-rate" {{ mesh.surface_mesh.growth_rate }}
/workflow/task/set "Generate the Surface Mesh" "curvature-normal-angle" {{ mesh.surface_mesh.curvature_normal_angle }}
/workflow/task/command "Generate the Surface Mesh" "yes"

; ── Describe Geometry ─────────────────────────────────────────────────
/workflow/task/set "Describe Geometry" "setup-type" "The geometry consists of only fluid regions with no voids"
/workflow/task/command "Describe Geometry" "yes"

; ── Enclose Fluid Regions (Virtual Wind Tunnel) ──────────────────────
/workflow/task/set "Enclose Fluid Regions (Capping)" "create-external-flow-boundaries?" "yes"
/workflow/task/set "Enclose Fluid Regions (Capping)" "flow-type" "Wind Tunnel"
/workflow/task/set "Enclose Fluid Regions (Capping)" "x-min" {{ mesh.wind_tunnel.x_min }}
/workflow/task/set "Enclose Fluid Regions (Capping)" "x-max" {{ mesh.wind_tunnel.x_max }}
/workflow/task/set "Enclose Fluid Regions (Capping)" "y-min" {{ mesh.wind_tunnel.y_min }}
/workflow/task/set "Enclose Fluid Regions (Capping)" "y-max" {{ mesh.wind_tunnel.y_max }}
/workflow/task/set "Enclose Fluid Regions (Capping)" "z-min" {{ mesh.wind_tunnel.z_min }}
/workflow/task/set "Enclose Fluid Regions (Capping)" "z-max" {{ mesh.wind_tunnel.z_max }}
/workflow/task/command "Enclose Fluid Regions (Capping)" "yes"

; ── Generate Volume Mesh ──────────────────────────────────────────────
/workflow/task/set "Generate the Volume Mesh" "volume-fill" "poly-hexcore"
/workflow/task/set "Generate the Volume Mesh" "max-cell-length" {{ mesh.volume_mesh.max_cell_length }}
/workflow/task/set "Generate the Volume Mesh" "enable-prism-layers?" "yes"
/workflow/task/set "Generate the Volume Mesh" "prism-layer-first-height" {{ mesh.volume_mesh.first_layer_height }}
/workflow/task/set "Generate the Volume Mesh" "prism-layer-total-layers" {{ mesh.volume_mesh.num_layers }}
/workflow/task/set "Generate the Volume Mesh" "prism-layer-growth-rate" {{ mesh.volume_mesh.bl_growth_rate }}
/workflow/task/command "Generate the Volume Mesh" "yes"

; ── Switch to Solver ──────────────────────────────────────────────────
/workflow/task/command "Switch to Solution Mode" "yes"

; ── Write Case ────────────────────────────────────────────────────────
/file/write-case "{{ output_case }}"

; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent SOLVER from existing mesh.cas.h5
; ANSYS 2025R1 — assumes the mesh artifact has already been written by a
; previous mesh-only job (mesh_only.jou.j2).
;
; Faithfully mirrors the CFD specialist's working ARC command-window flow:
;   /report/reference-values/...  →  /define/models/viscous/...  →
;   /define/boundary-conditions/...  →  /solve/init/hyb-init  →
;   /solve/iterate <N>  →  /file/write-case-data
; ════════════════════════════════════════════════════════════════════════

; ── Load the pre-built case ──────────────────────────────────────────
/file/read-case "{{ case_file }}"

; ── Print zone list for debugging ────────────────────────────────────
; Scheme, not %py-exec: this journal runs in a pure solver launch (no -meshing)
; where the meshing Python API is not available.
(display "=== ZONE LIST ===")(newline)
/define/boundary-conditions/list-zones

; ── Safety net: SOP-path enclosure cell zone must be fluid ──────────
; ti-menu-load-string is error-resilient: on VWT meshes (fluid zone is
; `tunnel-fluid`, no `enclosure` zone) this logs an error and continues,
; whereas the bare TUI line would abort the journal (probe 6380260 class).
(ti-menu-load-string "/define/boundary-conditions/zone-type enclosure fluid")

; ── Reference values, turbulence model, all BCs (shared partial) ─────
{% include '_bc_block.jou.j2' %}

{% include '_solution_methods.jou.j2' %}

; ── Report definitions, report files, convergence (shared partial) ───
{% include '_reports_block.jou.j2' %}

; ── Initialize ───────────────────────────────────────────────────────
{% if solver.initialization | default("hybrid") == "hybrid-absolute" %}
/solve/initialize/set-hyb-initialization/reference-frame absolute
/solve/initialize/hyb-initialization yes
{% else %}
/solve/init/hyb-init
{% endif %}

; ── Save case before iterating ───────────────────────────────────────
/file/write-case "{{ workspace }}/result.cas.h5"

; ── Iterate ──────────────────────────────────────────────────────────
/solve/iterate {{ solver.convergence.max_iterations | default(300) }}

; ── Export Results ───────────────────────────────────────────────────
{% if solver.data_export.case_data | default(true) %}
/file/write-case-data "{{ workspace }}/result.cas.h5"
{% endif %}

; ══════════════════════════════════════════════════════════════════════
; PHASE 4: POST-PROCESSING — Contour Images (shared partial)
; ══════════════════════════════════════════════════════════════════════
{% include '_contours_block.jou.j2' %}

/exit yes

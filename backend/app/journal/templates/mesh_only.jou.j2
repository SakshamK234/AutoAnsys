; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent Watertight MESH ONLY
; ANSYS 2025R1 — runs Watertight workflow, writes mesh.cas.h5, exits.
;
; The resulting mesh.cas.h5 is a first-class artifact consumed by one or
; many downstream solver jobs (solver_from_case.jou.j2).
; ════════════════════════════════════════════════════════════════════════

; ── Initialize Watertight Geometry Workflow ───────────────────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Watertight Geometry')")

; ── 1. Import Geometry ───────────────────────────────────────────────
; OneZonePer='body' — robust default for 2025R1. 'label' is not an accepted
; value ("Invalid Input label") and 'face' creates per-face zones that
; segfault Update Regions on car-scale geometries. With 'body', Discovery's
; face labels are preserved as CAD face labels on the body (not as zones).
; The Update Boundaries step below uses original_zones to assign each label
; group to its proper zone (inlet / outlet / ground / symmetry / walls).
; Note: SaveFacetedFile was removed from CadImportOptions in 2025R1.
(%py-exec "workflow.TaskObject['Import Geometry'].Arguments.set_state({'FileName': r'{{ geometry_file }}', 'LengthUnit': r'{{ mesh.geometry_unit | default("mm") }}', 'CadImportOptions': {'OneZonePer': r'body', 'FeatureAngle': 40.0, 'ExtractFeatures': r'yes'}, 'ImportCadPreferences': {'ShowImportCadPreferences': False, 'MaxFacetLength': 0}})")
(%py-exec "workflow.TaskObject['Import Geometry'].Execute()")

; ── 2. Add Local Sizing ──────────────────────────────────────────────
{% for region in mesh.local_sizing %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate()")
{% if region.type == "body_of_influence" %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({'AddChild': r'yes', 'BOIControlName': r'{{ region.name }}', 'BOIExecution': r'Body Of Influence', 'BOISize': {{ region.size }}, 'BOIGrowthRate': {{ region.growth_rate }}})")
{% else %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({'AddChild': r'yes', 'BOIControlName': r'{{ region.name }}', 'BOIExecution': r'Face Size', 'BOISize': {{ region.size }}, 'BOIGrowthRate': {{ region.growth_rate }}, 'BOIFaceLabelList': [{% for face in region.face_zones %}r'{{ face }}'{% if not loop.last %}, {% endif %}{% endfor %}]})")
{% endif %}
(%py-exec "workflow.TaskObject['Add Local Sizing'].Execute()")
{% endfor %}

; ── 3. Generate Surface Mesh ─────────────────────────────────────────
{% set original_zones = mesh.original_zones | default(["inlet", "outlet", "ground", "symmetry", "walls"]) %}
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Arguments.set_state({'CFDSurfaceMeshControls': {'DrawSizeControl': False, 'MinSize': {{ mesh.surface_mesh.min_size }}, 'MaxSize': {{ mesh.surface_mesh.max_size }}, 'GrowthRate': {{ mesh.surface_mesh.growth_rate }}, 'CurvatureNormalAngle': {{ mesh.surface_mesh.curvature_normal_angle }}, 'ScopeProximityTo': r'faces-and-edges'}, 'ExecuteShareTopology': r'No', 'OriginalZones': [{% for z in original_zones %}r'{{ z }}'{% if not loop.last %}, {% endif %}{% endfor %}]})")
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")

; ── 3b. Improve Surface Mesh ─────────────────────────────────────────
{% set mq = mesh.mesh_quality | default({}) %}
{% if mq.get('auto_improve', True) %}
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].InsertNextTask(CommandName='ImproveSurfaceMesh')")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Arguments.set_state({'FaceQualityLimit': {{ mq.get('surface_skewness_threshold', 0.6) }}, 'MeshObject': r'', 'SMImprovePreferences': {'AdvancedImprove': r'no', 'AllowDefeaturing': r'no', 'SIQualityCollapseLimit': 0.85, 'SIQualityIterations': 5, 'SIQualityMaxAngle': 160, 'SIRemoveStep': r'no', 'SIStepQualityLimit': 0, 'SIStepWidth': 0, 'ShowSMImprovePreferences': False}, 'SQMinSize': {{ mesh.surface_mesh.min_size }}, 'ScopeImproveTo': r'wall-zones'})")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Execute()")
{% endif %}

; ── 4. Describe Geometry ─────────────────────────────────────────────
(%py-exec "workflow.TaskObject['Describe Geometry'].UpdateChildTasks(Arguments={'v1': True}, SetupTypeChanged=False)")
(%py-exec "workflow.TaskObject['Describe Geometry'].Execute()")

; ── 5. Update Boundaries ─────────────────────────────────────────────
(%py-exec "workflow.TaskObject['Update Boundaries'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Boundaries'].Execute()")

; ── 6. Update Regions ────────────────────────────────────────────────
(%py-exec "workflow.TaskObject['Update Regions'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Regions'].Execute()")

; ── 7. Add Boundary Layers ──────────────────────────────────────────
; Prism layer count is driven from config (AUDIT C6 — volume_mesh.num_layers
; was previously ignored). NumberOfLayers is a stable Watertight arg.
; F9: target is wall-resolved y+ ≈ 1 (k-ω SST). When first_layer_height_mm is
; set, FirstHeight pins the first prism cell absolutely; when unset, the SOP
; last-ratio defaults are kept byte-for-byte (the team's proven flow).
; [needs-cluster] verify 2025R1 honours FirstHeight with OffsetMethodType='last-ratio'.
(%py-exec "workflow.TaskObject['Add Boundary Layers'].Arguments.set_state({'LocalPrismPreferences': {'Continuous': r'Continuous'}, 'OffsetMethodType': r'last-ratio', 'NumberOfLayers': {{ mesh.volume_mesh.num_layers | default(15) }}{% if mesh.volume_mesh.first_layer_height_mm %}, 'FirstHeight': {{ mesh.volume_mesh.first_layer_height_mm }}{% endif %}})")
(%py-exec "workflow.TaskObject['Add Boundary Layers'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['last-ratio_1'].Execute()")

; ── 8. Generate Volume Mesh ──────────────────────────────────────────
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")

; ── 8b. Improve Volume Mesh ──────────────────────────────────────────
{% if mq.get('auto_improve', True) %}
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].InsertNextTask(CommandName='ImproveVolumeMesh')")
(%py-exec "workflow.TaskObject['Improve Volume Mesh'].Execute()")
{% endif %}

; ══════════════════════════════════════════════════════════════════════
; Switch to solver mode purely to persist the mesh as a solver-readable
; case file. This is the artifact downstream jobs will read.
; ══════════════════════════════════════════════════════════════════════
switch-to-solution-mode
yes

; ── Print final zone list (sanity check for downstream BC assignment) ─
(display "=== MESH ZONE LIST ===")(newline)
/define/boundary-conditions/list-zones

; ── Write the mesh artifact ──────────────────────────────────────────
/file/write-case "{{ workspace }}/mesh.cas.h5"

; ── Report cell count for the mesh record ────────────────────────────
(display "=== MESH_CELL_COUNT_BEGIN ===")(newline)
/mesh/size-info
(display "=== MESH_CELL_COUNT_END ===")(newline)

; ── Done ──────────────────────────────────────────────────────────────
/exit yes

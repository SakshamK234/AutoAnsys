#!/bin/bash
#SBATCH --job-name={{ slurm.job_name | default("autoansys_cfd") }}
#SBATCH --nodes={{ slurm.nodes | default(1) }}
#SBATCH --ntasks-per-node={{ slurm.cores_per_node | default(32) }}
#SBATCH --mem={{ slurm.memory_gb | default(64) }}G
#SBATCH --time={{ "%02d" | format(slurm.walltime_hours | default(12)) }}:00:00
#SBATCH --partition={{ slurm.partition | default("compute") }}
#SBATCH --output={{ workspace }}/slurm-%j.out
#SBATCH --error={{ workspace }}/slurm-%j.err

echo "=== AutoAnsys Job Start: $(date) ==="
echo "Job ID: $SLURM_JOB_ID"
echo "Node:   $(hostname)"
echo "Cores:  $SLURM_NTASKS"

cd {{ workspace }}
module load {{ fluent_module }}

# Phase 1: Meshing
echo "=== Phase 1: Meshing ==="
fluent meshing -g -t${SLURM_NTASKS} -i mesh_watertight.jou
MESH_EXIT=$?
if [ $MESH_EXIT -ne 0 ]; then
    echo "MESHING_FAILED (exit code $MESH_EXIT)"
    exit $MESH_EXIT
fi

# Phase 2: Solving
echo "=== Phase 2: Solving ==="
fluent 3ddp -g -t${SLURM_NTASKS} -i solver.jou
SOLVE_EXIT=$?
if [ $SOLVE_EXIT -ne 0 ]; then
    echo "SOLVING_FAILED (exit code $SOLVE_EXIT)"
    exit $SOLVE_EXIT
fi

echo "=== AutoAnsys Job Complete: $(date) ==="
echo "JOB_COMPLETE"

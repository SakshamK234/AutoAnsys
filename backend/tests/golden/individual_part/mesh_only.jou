; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent FAULT-TOLERANT / VIRTUAL WIND TUNNEL mesh
; ANSYS 2025R1 — for multi-body assemblies and enclosure-carrying exports.
;
; This sequence was PROVEN LIVE on ARC TinkerCliffs (probes 6372187→6378056,
; see docs/CLUSTER_FINDINGS.md): import via PartManagement, ModelingObjective
; 'Virtual Wind Tunnel', Create External Flow Boundaries on the geometry's own
; enclosure body, fluid material point at the enclosure centroid, custom scoped
; sizing + size field, wrap → prisms → hexcore, write mesh.cas.h5.
;
; Requirements on the input CAD (matches the team's SOP exports):
;   • contains the part body/bodies AND an enclosure/bounding-box body
;     (Fluent objects arrive as e.g. ['enclosure', 'geom']);
;   • face labels are NOT required (unlabeled faces are wrapped).
; [needs-cluster] the final wrap→volume stage at production sizing is being
; validated (probe27); boundary naming of the tunnel faces comes from its zone
; list and feeds the solver BC template.
; ════════════════════════════════════════════════════════════════════════

; ── Initialize Fault-tolerant Meshing + register the CAD ─────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Fault-tolerant Meshing')")
(%py-exec "PartManagement.InputFileChanged(FilePath=r'/scratch/<user>/autoansys/jobs/<individual_part_job>/geometry.x_t', IgnoreSolidNames=False, PartPerBody=False)")
(%py-exec "PMFileManagement.FileManager.LoadFiles()")
(%py-exec "workflow.TaskObject['Import CAD and Part Management'].Execute()")
(display "IMPORT_DONE")(newline)



; ── Describe Geometry and Flow: Virtual Wind Tunnel objective ────────
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].Arguments.set_state({'ModelingObjective': r'Virtual Wind Tunnel'})")
(%py-exec "workflow.TaskObject['Describe Geometry and Flow'].Execute()")
(display "DGF_DONE")(newline)

; ── External flow boundaries from the geometry's own enclosure body ──
; Self-healing object pick: after import the objects are e.g.
; ['enclosure','geom']; CEFB renames the box to 'tunnel' on execute.
(%py-exec "objs = meshing_utilities.get_objects(filter=r'*')")
(%py-exec "print('OBJECTS:', objs)")
; Enclosure pick: prefer an explicitly named enclosure body, else the
; truncated 'v0' (Fluent cuts object names at the first dot, so
; 'v0.4-step-enclosure' arrives as 'v0' — fc8/fc9), else the non-'geom' one.
(%py-exec "encl = ([o for o in objs if str(o).lower() in ('enclosure','tunnel','box','bounding_box','boundingbox')] or [o for o in objs if 'enclosur' in str(o).lower()] or [o for o in objs if str(o).lower() == 'v0'] or [o for o in objs if str(o).lower() != 'geom'])[0]")
(%py-exec "body = ([o for o in objs if str(o).lower() not in (str(encl).lower(), 'tunnel')] or objs)[0]")
(%py-exec "print('ENCLOSURE_OBJECT:', encl, 'BODY_OBJECT:', body)")
; ExtractionMethod 'wrap' is REQUIRED with wrap-method fluid regions — with
; 'surface mesh' the post-wrap cleanup corrupts ("v-m-v-w", probe 6377117);
; with 'wrap' the full chain completed in 2m03s (probe 6379995).
(%py-exec "workflow.TaskObject['Create External Flow Boundaries'].Arguments.set_state({'CreationMethod': r'Use existing boundary', 'SelectionType': r'object', 'ObjectSelectionSingle': [encl], 'ExtractionMethod': r'wrap'})")
(%py-exec "workflow.TaskObject['Create External Flow Boundaries'].Execute()")
(display "CEFB_DONE")(newline)

; ── Fluid region: material point at the tunnel centroid ──────────────
; The SOP enclosure is asymmetric (long wake), so its centroid sits in open
; fluid. CEFB renamed the box object to 'tunnel' — requery before selecting.
(%py-exec "objs2 = meshing_utilities.get_objects(filter=r'*')")
(%py-exec "mp = ([o for o in objs2 if str(o).lower() in ('tunnel','enclosure')] or [o for o in objs2 if str(o).lower() != str(body).lower()])[0]")
(%py-exec "workflow.TaskObject['Identify Regions'].Arguments.set_state({'AddChild': r'yes', 'MaterialPointsName': r'tunnel-fluid', 'MptMethodType': r'Centroid of Objects', 'NewRegionType': r'fluid', 'SelectionType': r'object', 'ObjectSelectionList': [mp]})")
(%py-exec "workflow.TaskObject['Identify Regions'].AddChildAndUpdate(DeferUpdate=False)")
(display "IDREG_DONE")(newline)

; ── Region settings (body → void, tunnel-fluid → fluid/hexcore/wrap) ─
(%py-exec "workflow.TaskObject['Update Region Settings'].Execute()")
(display "URS_DONE")(newline)

; ── Mesh sizing: workflow DEFAULTS (proven on ARC) ────────────────────
; Probe evidence (6377338→6379995, CLUSTER_FINDINGS.md): CreationMethod
; 'Custom' REPLACES the workflow's default control set — the wrap then loses
; body/proximity resolution and degenerates (2,460 faces @ skew 1.0), and low
; global floors explode the size-field octree (30–105 min). The DEFAULT
; controls wrapped this class of geometry in ~13 s at avg skew 0.084.
; Finer resolution is added as scoped controls ON TOP of defaults below.
; ── Scoped curvature+proximity sizing on the CAR objects only (fc10) ──
; Default sizing alone wraps this car at only ~89k cells (fc9) — too coarse
; for aero. Scoped controls on the car objects (never the tunnel shell)
; refine the wrap where it matters: 2.0–16.0 mm,
; 3 cells/gap. AddChildAndUpdate — never 'Custom' (fc10 → 2.17M cells).
(%py-exec "carobjs = [str(o) for o in objs if str(o).lower() != str(encl).lower()]")
(%py-exec "print('CAR_OBJECTS:', len(carobjs))")
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'LocalSettingsName': r'car-curvature', r'SelectionType': r'object', r'ObjectSelectionList': carobjs, r'LocalSizeControlParameters': {r'SizingType': r'curvature', r'MinSize': 2.0, r'MaxSize': 16.0, r'GrowthRate': 1.2, r'CurvatureNormalAngle': 18.0, r'ScopeProximityTo': r'faces-and-edges'}})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'LocalSettingsName': r'car-proximity', r'SelectionType': r'object', r'ObjectSelectionList': carobjs, r'LocalSizeControlParameters': {r'SizingType': r'proximity', r'MinSize': 2.0, r'MaxSize': 16.0, r'GrowthRate': 1.2, r'CellsPerGap': 3, r'ScopeProximityTo': r'faces'}})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
(display "SCOPED_SIZING_DONE")(newline)
(%py-exec "workflow.TaskObject['Choose Mesh Control Options'].Execute()")
(display "CMCO_DONE")(newline)

; ── Wrap → regions → boundaries → prisms → volume ─────────────────────
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")
(display "SURF_DONE")(newline)
(%py-exec "workflow.TaskObject['Compute Regions'].Execute()")
(%py-exec "workflow.TaskObject['Update Boundaries'].Execute()")
(%py-exec "workflow.TaskObject['Update Region Settings'].Execute()")
(display "REGIONS_DONE")(newline)
(%py-exec "workflow.TaskObject['Generate Boundary Layers'].Execute()")
(display "PRISMS_DONE")(newline)
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")
(display "VOLUME_DONE")(newline)

; Geometric boundary classification (does its own switch-to-solution-mode;
; leaves named tunnel-plane + body zones ready for the solver BC block).
; carve_domain present → full-car (body touches ground → slab carve);
; absent → component (part floats in the box → six clean box faces, no carve).
; ════════════════════════════════════════════════════════════════════════
; FT WRAP — COMPONENT BOUNDARY CLASSIFIER (probe33, wing-validated)
; Included by mesh_fault_tolerant.jou.j2 when classify_boundaries is set and
; NO carve_domain is configured — i.e. a single part / sub-assembly that
; FLOATS inside the tunnel box (does not touch the ground). Unlike the
; full-car case, the six box faces come out as clean separate zones and the
; body never fuses with the ground, so there is no slab carve.
;
; Method (probe33, job 6380198): the six LARGEST face zones are the tunnel
; box; everything else is the part body. Each box face is named by its thin
; axis + position — inlet (x nearer the body) / outlet (x far) / ground
; (z-min) / farfield-top (z-max) / symmetry (y-min, the half-model cut) /
; farfield-side (y-max). The body zones merge into 'body'. The rename scheme
; is written to a file and loaded after the mode switch (merge-zones /
; zone-name are solution-mode ops).
; ════════════════════════════════════════════════════════════════════════

(display "CLASSIFY_BEGIN")(newline)
(%py-exec "allz = [int(z) for z in meshing_utilities.get_face_zones(filter=r'*')]")
(%py-exec "interior = set(int(z) for z in meshing_utilities.get_face_zones(filter=r'interior*'))")
(%py-exec "meshz = [z for z in allz if z not in interior]")
(%py-exec "print('MESH_FACE_ZONES:', len(meshz), 'of', len(allz))")
(%py-exec "amap = {z: float(meshing_utilities.get_face_zone_area(face_zone_id_list=[z])) for z in meshz}")
(%py-exec "big = sorted(amap, key=lambda z: -amap[z])[:6]")
(%py-exec "body = [z for z in meshz if z not in big]")
(%py-exec "print('BOX_FACES:', big, 'BODY_ZONES:', body)")
(%py-exec "assert len(big) == 6, 'expected 6 tunnel box faces, got ' + str(len(big))")
(%py-exec "assert body, 'no body zones left after removing the 6 box faces'")
(%py-exec "E = {z: meshing_utilities.get_bounding_box_of_zone_list(zone_id_list=[z]) for z in big}")
(%py-exec "xmin = min(E[z][0][0] for z in big); xmax = max(E[z][1][0] for z in big)")
(%py-exec "def span(z, i): return E[z][1][i] - E[z][0][i]")
(%py-exec "def thin_axis(z): d = [span(z, 0), span(z, 1), span(z, 2)]; return d.index(min(d))")
(%py-exec "def ctr(z, i): return 0.5 * (E[z][0][i] + E[z][1][i])")
; Body centroid (x) decides which x-face is the inlet (the nearer one).
(%py-exec "bE = {z: meshing_utilities.get_bounding_box_of_zone_list(zone_id_list=[z]) for z in body}")
(%py-exec "bcx = 0.5 * (min(bE[z][0][0] for z in body) + max(bE[z][1][0] for z in body))")
(%py-exec "xf = sorted([z for z in big if thin_axis(z) == 0], key=lambda z: ctr(z, 0))")
(%py-exec "yf = sorted([z for z in big if thin_axis(z) == 1], key=lambda z: ctr(z, 1))")
(%py-exec "zf = sorted([z for z in big if thin_axis(z) == 2], key=lambda z: ctr(z, 2))")
(%py-exec "assert len(xf) == 2 and len(yf) == 2 and len(zf) == 2, 'box faces not 2 per axis: x=' + str(xf) + ' y=' + str(yf) + ' z=' + str(zf)")
(%py-exec "names = {}")
(%py-exec "names[xf[0]] = 'inlet' if abs(bcx - ctr(xf[0], 0)) < abs(bcx - ctr(xf[1], 0)) else 'outlet'")
(%py-exec "names[xf[1]] = 'outlet' if names[xf[0]] == 'inlet' else 'inlet'")
(%py-exec "names[zf[0]] = 'ground'; names[zf[1]] = 'farfield-top'")
(%py-exec "names[yf[0]] = 'symmetry'; names[yf[1]] = 'farfield-side'")
(%py-exec "print('ASSIGNED:', {z: names[z] for z in big})")
(%py-exec "assert sorted(names.values()) == ['farfield-side', 'farfield-top', 'ground', 'inlet', 'outlet', 'symmetry'], 'component classifier names: ' + str(sorted(names.values()))")
(%py-exec "f = open(r'/scratch/<user>/autoansys/jobs/<individual_part_job>/assign.scm', 'w')")
(%py-exec "q = chr(34); nl = chr(10)")
(%py-exec "[f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/zone-name ' + str(z) + ' ' + names[z] + q + ')' + nl) for z in big]")
(%py-exec "f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/merge-zones ' + ' '.join(str(z) for z in body) + ' ()' + q + ')' + nl) if len(body) > 1 else None")
(%py-exec "f.write('(ti-menu-load-string ' + q + '/mesh/modify-zones/zone-name ' + str(body[0]) + ' body' + q + ')' + nl)")
(%py-exec "f.close()")
(display "CLASSIFIER_DONE")(newline)

switch-to-solution-mode
yes

(load "/scratch/<user>/autoansys/jobs/<individual_part_job>/assign.scm")
(display "ASSIGN_LOADED")(newline)

; Pin flow-boundary zone TYPES into the mesh so the shared solver BC block
; only has to set VALUES (ground / farfield / body stay the default wall type).
/define/boundary-conditions/zone-type inlet velocity-inlet
/define/boundary-conditions/zone-type outlet pressure-outlet
/define/boundary-conditions/zone-type symmetry symmetry
(display "ZONE_TYPES_PINNED")(newline)

(display "=== MESH ZONE LIST ===")(newline)
/define/boundary-conditions/list-zones

; ══════════════════════════════════════════════════════════════════════
; MESH-ONLY (split workflow) — persist the mesh; a separate solver job reads
; mesh.cas.h5 (zones already named/typed by the classify/carve block).
; ══════════════════════════════════════════════════════════════════════
/file/write-case "/scratch/<user>/autoansys/jobs/<individual_part_job>/mesh.cas.h5"
(display "=== MESH_CELL_COUNT_BEGIN ===")(newline)
/mesh/size-info
(display "=== MESH_CELL_COUNT_END ===")(newline)
/exit yes

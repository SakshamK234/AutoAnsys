; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent Watertight Geometry + Solver
; Single-session: mesh in meshing mode → switch-to-solution-mode → solve
; ANSYS 2025R1 — (%py-exec ...) Python workflow API
;
; Follows the team SOPs:
;   - CFD_SOP (Individual Part)   → cfd_mode = "individual_part"
;   - Kevin Full Car Reference    → cfd_mode = "full_car"
; ════════════════════════════════════════════════════════════════════════

; ══════════════════════════════════════════════════════════════════════
; PHASE 1: MESHING
; ══════════════════════════════════════════════════════════════════════

; ════════════════════════════════════════════════════════════════════════
; SHARED WATERTIGHT MESH PHASE — included by mesh_watertight.jou.j2
; (combined mesh+solve) and mesh_only.jou.j2 (split workflow) so the two
; paths cannot diverge. Wing-validated SOP path + specialist full-car
; recipe (meshjournal.jou on V0.4-stepFC), both config-driven.
; ════════════════════════════════════════════════════════════════════════

; ── Initialize Watertight Geometry Workflow ───────────────────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Watertight Geometry')")

; ── 1. Import Geometry ───────────────────────────────────────────────
; OneZonePer='body' — robust default for 2025R1. 'label' is rejected
; ("Invalid Input label") and 'face' creates per-face zones that segfault
; Update Regions ("> invalid argument: not a number") on car-scale
; geometries. Discovery face labels survive as CAD face labels on the body;
; Update Boundaries below uses original_zones to map them to the SOP zone
; names (inlet / outlet / ground / symmetry / walls).
; NOTE: SaveFacetedFile was removed from CadImportOptions in 2025R1
;       ("Illegitimate input at /ImportGeometry/CadImportOptions").
; pin_cad_import_options=false (specialist full-car path) sets only
; FileName/LengthUnit and leaves every import option at task defaults,
; matching the specialist journal byte-for-byte.
(%py-exec "workflow.TaskObject['Import Geometry'].Arguments.set_state({r'FileName': r'/scratch/<user>/autoansys/jobs/<full_car_job>/geometry.x_t', r'LengthUnit': r'mm'})")
(%py-exec "workflow.TaskObject['Import Geometry'].Execute()")

; ── 1b. Create Local Refinement Regions (specialist full-car journal) ─
; Wake/nearfield BOI boxes. Task is not built-in — inserted after Import.
; Relative boxes size 'Ratio relative to geometry size' around the selected
; face labels; absolute boxes use 'Directly specify coordinates'.
(%py-exec "workflow.TaskObject['Import Geometry'].InsertNextTask(CommandName=r'CreateLocalRefinementRegions')")
(%py-exec "workflow.TaskObject['Create Local Refinement Regions'].Arguments.set_state({r'BOIMaxSize': 5.0, r'CreationMethod': r'Box', r'SelectionType': r'label', r'LabelSelectionList': [r'front-left-wheel'], r'BoundingBoxObject': {r'SizeRelativeLength': r'Ratio relative to geometry size', r'XminRatio': 1.0, r'XmaxRatio': 0.1, r'YminRatio': 0.1, r'YmaxRatio': 0.1, r'ZminRatio': 0.1, r'ZmaxRatio': 0.1}, r'RefinementRegionsName': r'front-tire-wake'})")
(%py-exec "workflow.TaskObject['Create Local Refinement Regions'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Create Local Refinement Regions'].Arguments.set_state({r'BOIMaxSize': 5.0, r'CreationMethod': r'Box', r'SelectionType': r'label', r'LabelSelectionList': [r'rear-left-wheel'], r'BoundingBoxObject': {r'SizeRelativeLength': r'Ratio relative to geometry size', r'XminRatio': 1.5, r'XmaxRatio': 0.1, r'YminRatio': 2.5, r'YmaxRatio': 0.1, r'ZminRatio': 0.1, r'ZmaxRatio': 0.1}, r'RefinementRegionsName': r'rear-tire-wake'})")
(%py-exec "workflow.TaskObject['Create Local Refinement Regions'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Create Local Refinement Regions'].Arguments.set_state({r'BOIMaxSize': 10.0, r'CreationMethod': r'Box', r'BoundingBoxObject': {r'SizeRelativeLength': r'Directly specify coordinates', r'Xmin': -1500.0, r'Xmax': 2500.0, r'Ymin': 31.68325805664045, r'Ymax': 1000.0, r'Zmin': -38.14357504844666, r'Zmax': 2000.0}, r'RefinementRegionsName': r'nearfield'})")
(%py-exec "workflow.TaskObject['Create Local Refinement Regions'].AddChildAndUpdate(DeferUpdate=False)")

; ── 2. Add Local Sizing ──────────────────────────────────────────────
; SOP local-sizing categories: aero / chassis / wheels / intake.
; Pattern per specialist journal: set_state({AddChild: yes, …}) then
; AddChildAndUpdate(DeferUpdate=False) — no separate Execute.
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'AddChild': r'yes', r'BOIControlName': r'fw-rw-whisker', r'BOIExecution': r'Face Size', r'BOISize': 5.0, r'BOIGrowthRate': 1.2, r'BOICellsPerGap': 1, r'BOICurvatureNormalAngle': 18.0, r'BOIZoneorLabel': r'label', r'BOIFaceLabelList': [r'front-wing', r'rear-wing', r'whisker']})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'AddChild': r'yes', r'BOIControlName': r'trailing-edges', r'BOIExecution': r'Face Size', r'BOISize': 0.25, r'BOIGrowthRate': 1.2, r'BOICellsPerGap': 1, r'BOICurvatureNormalAngle': 18.0, r'BOIZoneorLabel': r'label', r'BOIFaceLabelList': [r'trailing-edges']})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'AddChild': r'yes', r'BOIControlName': r'undertray', r'BOIExecution': r'Face Size', r'BOISize': 2.5, r'BOIGrowthRate': 1.2, r'BOICellsPerGap': 1, r'BOICurvatureNormalAngle': 18.0, r'BOIZoneorLabel': r'label', r'BOIFaceLabelList': [r'undertray']})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'AddChild': r'yes', r'BOIControlName': r'chassis', r'BOIExecution': r'Face Size', r'BOISize': 10.0, r'BOIGrowthRate': 1.2, r'BOICellsPerGap': 1, r'BOICurvatureNormalAngle': 18.0, r'BOIZoneorLabel': r'label', r'BOIFaceLabelList': [r'chassis']})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['Add Local Sizing'].Arguments.set_state({r'AddChild': r'yes', r'BOIControlName': r'wheels', r'BOIExecution': r'Face Size', r'BOISize': 10.0, r'BOIGrowthRate': 1.2, r'BOICellsPerGap': 1, r'BOICurvatureNormalAngle': 18.0, r'BOIZoneorLabel': r'label', r'BOIFaceLabelList': [r'front-left-wheel', r'rear-left-wheel']})")
(%py-exec "workflow.TaskObject['Add Local Sizing'].AddChildAndUpdate(DeferUpdate=False)")

; ── 3. Generate Surface Mesh ─────────────────────────────────────────
; SOP path: ExecuteShareTopology='No' + explicit OriginalZones (Discovery
; labels). Specialist full-car path: original_zones null → both keys omitted,
; task defaults handle the labelled STEP.
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Arguments.set_state({'CFDSurfaceMeshControls': {'DrawSizeControl': False, 'MinSize': 1.0, 'MaxSize': 50.0, 'GrowthRate': 1.2, 'CurvatureNormalAngle': 18.0, 'ScopeProximityTo': r'faces-and-edges'}})")
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")

; Specialist ordering: Describe Geometry is primed (set_state(None) +
; UpdateChildTasks) BEFORE Improve Surface Mesh, then configured after it.
(%py-exec "workflow.TaskObject['Describe Geometry'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Describe Geometry'].UpdateChildTasks(Arguments={r'v1': True}, SetupTypeChanged=False)")

; ── 3b. Improve Surface Mesh (SOP FaceQualityLimit 0.6, wall-zones scope) ─
; Improve Surface Mesh is NOT a built-in Watertight task — must be inserted
; after Generate Surface Mesh before TaskObject[...] can reference it.
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].InsertNextTask(CommandName='ImproveSurfaceMesh')")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Arguments.set_state({'FaceQualityLimit': 0.6, 'MeshObject': r'', 'SMImprovePreferences': {'AdvancedImprove': r'no', 'AllowDefeaturing': r'no', 'SIQualityCollapseLimit': 0.85, 'SIQualityIterations': 5, 'SIQualityMaxAngle': 160, 'SIRemoveStep': r'no', 'SIStepQualityLimit': 0, 'SIStepWidth': 0, 'ShowSMImprovePreferences': False}, 'SQMinSize': 0.25, 'ScopeImproveTo': r'wall-zones'})")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Execute()")

; ── 4. Describe Geometry ─────────────────────────────────────────────
; Specialist full-car journal: the CAD models the tunnel-minus-car FLUID
; volume directly → declare fluid-only regions (+ wall-to-internal), with
; SetupTypeChanged=True so child tasks re-seed.
(%py-exec "workflow.TaskObject['Describe Geometry'].UpdateChildTasks(Arguments={r'v1': True}, SetupTypeChanged=False)")
(%py-exec "workflow.TaskObject['Describe Geometry'].Arguments.set_state({r'NonConformal': r'No', r'SetupType': r'The geometry consists of only fluid regions with no voids', r'WallToInternal': r'Yes'})")
(%py-exec "workflow.TaskObject['Describe Geometry'].UpdateChildTasks(Arguments={r'v1': True}, SetupTypeChanged=True)")
(%py-exec "workflow.TaskObject['Describe Geometry'].Execute()")

; ── 5. Update Boundaries ─────────────────────────────────────────────
; Reference: set_state(None) then Execute — picks up the Discovery-applied labels.
(%py-exec "workflow.TaskObject['Update Boundaries'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Boundaries'].Execute()")

; ── 6. Update Regions ────────────────────────────────────────────────
(%py-exec "workflow.TaskObject['Update Regions'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Regions'].Execute()")

; ── 7. Add Boundary Layers ──────────────────────────────────────────
; SOP: last-ratio offset method with Continuous local-prism preference.
; NumberOfLayers driven from config (AUDIT C6 — volume_mesh.num_layers was ignored).
; F9: wall-resolved y+ ≈ 1 target; optional FirstHeight when first_layer_height_mm
; is set (unset keeps the proven SOP last-ratio defaults).
; [needs-cluster] verify 2025R1 honours FirstHeight with OffsetMethodType='last-ratio'.
; Specialist full-car journal: grow prisms only on the selected body labels
; (BLControlName 'last-ratio_1', FaceScope 'selected-labels'); the
; AddChildAndUpdate(DeferUpdate=False) performs the update — no Execute.
(%py-exec "workflow.TaskObject['Add Boundary Layers'].Arguments.set_state({r'BLControlName': r'last-ratio_1', r'BlLabelList': [r'chassis', r'front-left-wheel', r'front-wing', r'rear-left-wheel', r'rear-wing', r'suspension', r'trailing-edges', r'undertray', r'whisker'], r'FaceScope': {r'GrowOn': r'selected-labels'}, r'LocalPrismPreferences': {r'Continuous': r'Continuous'}, r'NumberOfLayers': 6, r'OffsetMethodType': r'last-ratio'})")
(%py-exec "workflow.TaskObject['Add Boundary Layers'].AddChildAndUpdate(DeferUpdate=False)")

; ── 8. Generate Volume Mesh ──────────────────────────────────────────
; Specialist full-car journal: poly-hexcore fill with HexMaxCellLength.
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Arguments.set_state({r'VolumeFill': r'poly-hexcore', r'VolumeFillControls': {r'HexMaxCellLength': 32.0}})")
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")

; ── 8b. Improve Volume Mesh (SOP ortho-quality threshold 0.15) ───────
; Same pattern — must be inserted before reference. Gated separately from the
; surface improve: the specialist full-car journal skips it.


; ══════════════════════════════════════════════════════════════════════
; TRANSITION: Switch from meshing mode to solver mode
; The mesh stays in memory — no file write/read needed
; ══════════════════════════════════════════════════════════════════════
switch-to-solution-mode
yes

; ══════════════════════════════════════════════════════════════════════
; PHASE 2: SOLVER SETUP
; ══════════════════════════════════════════════════════════════════════

; ── Print zone list for debugging ─────────────────────────────────────
; Zones come from Discovery-applied face labels on the Parasolid export.
; Expected: inlet, outlet, ground, symmetry, walls (+ aero components for full car).
(display "=== ZONE LIST ===")(newline)
/define/boundary-conditions/list-zones

; ── Safety net: force enclosure cell zone to fluid ────────────────────
; If Discovery exported the enclosure as a solid body, flip it here. Wrapped
; in ti-menu-load-string so a missing zone logs an error without aborting.
(ti-menu-load-string "/define/boundary-conditions/zone-type enclosure fluid")

; ── Reference values, turbulence model, all BCs (shared partial) ─────
; ════════════════════════════════════════════════════════════════════════
; SHARED BC + REFERENCE-VALUES BLOCK
; Included by both solver_from_case.jou.j2 (split workflow) and
; mesh_watertight.jou.j2 Phase 2 (combined workflow).
;
; Each BC list emits one Fluent TUI command per entry. The argument order
; mirrors the working specialist script (Max Squat full-car) byte-for-byte
; so reproducing it as a flat journal yields the same setup as the manual
; /define/boundary-conditions/... typing in the ARC command window.
; ════════════════════════════════════════════════════════════════════════

; ── Reference Values ──────────────────────────────────────────────────
; density is required for physical force COEFFICIENTS (AUDIT C4 — was unset).
/report/reference-values/area 1.0
/report/reference-values/length 1.5367
/report/reference-values/velocity 15.65
/report/reference-values/density 1.225

; ── Turbulence Model ──────────────────────────────────────────────────
/define/models/viscous/kw-sst? yes
/define/models/viscous/curvature-correction? yes


; ── Velocity inlets ───────────────────────────────────────────────────
/define/boundary-conditions/velocity-inlet inlet no no yes yes no 15.65 no 0. no no yes 5.0 10.0

; ── Rotating walls (wheels) ──────────────────────────────────────────
; TUI: zone yes motion-bc-moving no no yes yes no no 0. no 0.5 no <ω> <ox> <oy> <oz> <ax> <ay> <az>
/define/boundary-conditions/zone-type front-tire wall
/define/boundary-conditions/wall front-tire yes motion-bc-moving no no yes yes no no 0. no 0.5 no 77.0 0.8264 0.6125 0.1998 0.0 1.0 0.0
/define/boundary-conditions/zone-type rear-tire wall
/define/boundary-conditions/wall rear-tire yes motion-bc-moving no no yes yes no no 0. no 0.5 no 77.0 -0.7056 0.6125 0.1998 0.0 1.0 0.0

; ── Translating walls (e.g. moving ground) ───────────────────────────
; TUI: zone yes motion-bc-moving no no yes no no <vel> <dx> <dy> <dz> no no 0. no 0.5
/define/boundary-conditions/zone-type ground wall
/define/boundary-conditions/wall ground yes motion-bc-moving no no yes no no 15.65 -1.0 0.0 0.0 no no 0. no 0.5

; ── Slip / specified-shear walls (tunnel walls, contact patches) ─────
; TUI: zone no yes shear-bc-spec-shear no no 0. no 0.5 no 0. no 0. no 0.
/define/boundary-conditions/zone-type tunnel-walls wall
/define/boundary-conditions/wall tunnel-walls no yes shear-bc-spec-shear no no 0. no 0.5 no 0. no 0. no 0.
/define/boundary-conditions/zone-type contact-patches wall
/define/boundary-conditions/wall contact-patches no yes shear-bc-spec-shear no no 0. no 0.5 no 0. no 0. no 0.

; ── Stationary no-slip walls ─────────────────────────────────────────
; Default Fluent wall behaviour; we just pin the zone-type explicitly.

; ── Pressure outlets ─────────────────────────────────────────────────
; 2025R1: the parameter is `gauge-pressure` — `pgauge` is rejected as an
; invalid command (verified on ARC, probe 6380260).
/define/boundary-conditions/zone-type outlet pressure-outlet
/define/boundary-conditions/set/pressure-outlet outlet () gauge-pressure no 0.0 quit

; ── Symmetry planes ──────────────────────────────────────────────────
/define/boundary-conditions/zone-type symmetry symmetry

; ── Solution Methods (2025R1-validated TUI, probes 6380286–6380410) ────
; The TUI takes NUMERIC enums, not names ("Coupled"/"second-order" raise
; "unbound variable"/"Invalid integer" and abort the journal). Config keeps the
; human-readable names; this partial maps them.
/solve/set/p-v-coupling 24
; gradient-scheme: left at the case default (least-squares cell based) — the
; TUI form is a yes/no prompt pair; [needs-cluster] wire if a non-default is needed.
/solve/set/discretization-scheme/pressure 12
/solve/set/discretization-scheme/mom 1
/solve/set/discretization-scheme/k 1
/solve/set/discretization-scheme/omega 1

; ══════════════════════════════════════════════════════════════════════
; PHASE 3: SOLVER RUN
; ══════════════════════════════════════════════════════════════════════

; ── Report definitions, report files, convergence (shared partial) ───
; ════════════════════════════════════════════════════════════════════════
; SHARED REPORTS + CONVERGENCE BLOCK
; Included by solver_from_case.jou.j2 and mesh_watertight.jou.j2 so the two
; never diverge (a past divergence left the combined journal with undefined
; contour-surface variables — AUDIT C7).
;
; Forces/moment are integrated over the BODY wall zone(s) only, via
; reporting.body_wall_pattern — NOT the previous `thread-names *`, which also
; summed the moving ground and tunnel walls (AUDIT C3). Outputs are FORCES in
; Newtons (drag_force, lift_force, mom_y). The coefficients Cd/Cl/Cm and the
; half-model symmetry doubling are computed downstream in app/post/forces.py
; from these forces + the reference values, so the journal does not depend on
; the version-specific coefficient-report TUI.
; ════════════════════════════════════════════════════════════════════════


; ── Report Definitions (body-scoped forces; AUDIT C2/C3) ──────────────
; 2025R1-validated (probes 6380332/6380354): force defs take force-vector +
; thread-names; the MOMENT def takes `mom-center` + `mom-axis` (the older
; `moment-vector`/`moment-center` pair is rejected).
/solve/report-definitions/add drag_force force force-vector 1 0 0 thread-names wall-body* () quit
/solve/report-definitions/add lift_force force force-vector 0 0 1 thread-names wall-body* () quit
/solve/report-definitions/add mom_y moment mom-center 0.0 0.0 0.0 mom-axis 0 1 0 thread-names wall-body* () quit

; ── Report Files ──────────────────────────────────────────────────────
; Residuals: `report-files/add ... report-type iteration` is NOT valid 2025R1
; TUI (probe 6380354) — residual history is parsed from the transcript
; (fluent.log) instead; the tolerant parser (app/post/report_files.py) handles it.
/solve/report-files/add forces-report report-defs drag_force lift_force mom_y () file-name "/scratch/<user>/autoansys/jobs/<full_car_job>/forces.csv" print? yes quit

; ── Convergence Monitors ──────────────────────────────────────────────
/solve/monitors/residual/convergence-criteria 0.0001 0.0001 0.0001 0.0001 0.0001 0.0001
; Force-plateau convergence (AUDIT C5): the guessed
; `/solve/convergence-conditions/add ...` phrase is NOT valid 2025R1 TUI
; (probe 6380382: invalid command "add"). Until the correct syntax is
; discovered (help-dump probe pending), the fixed `/solve/iterate N` below is
; the stop condition — convergence is then judged from the forces.csv plateau
; in post-processing. config: convergence.use_force_convergence reserved.

; ── Initialize ────────────────────────────────────────────────────────
/solve/init/hyb-init

; ── Save case file before iterating (SOP step) ────────────────────────
; Distinct from the post-solve write — same-name write-case-data triggers an
; overwrite prompt in batch that desyncs the journal (probe 6387661).
/file/write-case "/scratch/<user>/autoansys/jobs/<full_car_job>/setup.cas.h5"

; ── Run (SOP: individual part 300, full car 3000) ─────────────────────
/solve/iterate 750

; ── Export Results ────────────────────────────────────────────────────
/file/write-case-data "/scratch/<user>/autoansys/jobs/<full_car_job>/result.cas.h5"

; ══════════════════════════════════════════════════════════════════════
; PHASE 4: POST-PROCESSING — Contour Images (shared partial)
; ══════════════════════════════════════════════════════════════════════
; ════════════════════════════════════════════════════════════════════════
; SHARED CONTOUR / POST-PROCESSING BLOCK — 2025R1-validated (probe 6388066;
; views validated probes 6388814/6389014, imagery confirmed job 6388594).
;
; Idiom notes (all verified live on ARC):
; • Requires the solver stage to launch with `-gu -driver null` — with `-g`
;   the graphics subsystem is absent and `display save-picture` does not exist.
; • Every command goes through (ti-menu-load-string "...") — TUI menu state
;   persists across journal lines and leading `/` resolves RELATIVE to the
;   current menu, so bare paths desync after any menu-entering command.
; • Contours are display OBJECTS (`display objects create contour ...`) — the
;   legacy /display/set/contours/* menu no longer exists.
; • View commands only affect an EXISTING graphics window, and the headless
;   window is created lazily by the first `display` — so the order per image
;   must be: display (bootstrap) → camera → display again (redraw) →
;   auto-scale (fit content, keeps direction) → save-picture. A views command
;   issued before any display, or a save without re-display, yields an empty
;   canvas (probes 6388814/6389014).
; ════════════════════════════════════════════════════════════════════════


(ti-menu-load-string "display set picture driver png")
(ti-menu-load-string "display set picture x-resolution 1920")
(ti-menu-load-string "display set picture y-resolution 1080")

; Mid-SPAN cross-section for flow-field views (validated arg order). In the
; team's CAD convention z is UP (ground at z=0, probe 6380144 extents) — the
; side-view slice is y=0 (imagery confirmed on job 6388594).
(ti-menu-load-string "surface iso-surface y-coordinate midplane-y () () 0 ()")

; DEFAULT VIEW ONLY. The camera/restore-view sequence renders EMPTY canvases
; on real solved cases even with re-display + auto-scale (fc29p-fc31p, jobs
; 6408623/6408669/6408714 — views apply per the axis triad but no content
; draws under -driver null). The default view is the only rendering path
; proven to produce content (acceptance-2 job 6388594 + fc31p). Sideways
; framing remains an open polish item — do NOT reintroduce view commands
; without a probe-validated recipe. Also: save-picture on an EXISTING file
; raises an overwrite prompt that desyncs the journal (fc30p) — filenames
; here are safe only because production workspaces are unique per job.
(ti-menu-load-string "display objects create contour cont-velocity field velocity-magnitude surfaces-list midplane-y () quit")
(ti-menu-load-string "display objects display cont-velocity")
(ti-menu-load-string "display save-picture \"/scratch/<user>/autoansys/jobs/<full_car_job>/contour_velocity_midplane.png\"")

(ti-menu-load-string "display objects create contour cont-pressure field pressure surfaces-list midplane-y () quit")
(ti-menu-load-string "display objects display cont-pressure")
(ti-menu-load-string "display save-picture \"/scratch/<user>/autoansys/jobs/<full_car_job>/contour_pressure_midplane.png\"")

(ti-menu-load-string "display objects create contour cont-tke field turb-kinetic-energy surfaces-list midplane-y () quit")
(ti-menu-load-string "display objects display cont-tke")
(ti-menu-load-string "display save-picture \"/scratch/<user>/autoansys/jobs/<full_car_job>/contour_tke_midplane.png\"")

; Pressure coefficient on the body walls.
(ti-menu-load-string "display objects create contour cont-cp field pressure-coefficient surfaces-list wall-body* () quit")
(ti-menu-load-string "display objects display cont-cp")
(ti-menu-load-string "display save-picture \"/scratch/<user>/autoansys/jobs/<full_car_job>/contour_cp.png\"")

; ── Done ──────────────────────────────────────────────────────────────
/exit yes

-12.455
-0.001
3.686
max-point
3.9419999999999997
3.21
3.727
quit
quit
/mesh/modify-zones/sep-face-zone-mark car-shell top_slab yes
(display "SEP_TOP_SLAB_DONE")(newline)
mesh adapt cell-registers add
inlet_slab

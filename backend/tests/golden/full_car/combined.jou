; ════════════════════════════════════════════════════════════════════════
; Auto-generated by AutoAnsys — Fluent Watertight Geometry + Solver
; Single-session: mesh in meshing mode → switch-to-solution-mode → solve
; ANSYS 2025R1 — (%py-exec ...) Python workflow API
;
; Follows the team SOPs:
;   - CFD_SOP (Individual Part)   → cfd_mode = "individual_part"
;   - Kevin Full Car Reference    → cfd_mode = "full_car"
; ════════════════════════════════════════════════════════════════════════

; ══════════════════════════════════════════════════════════════════════
; PHASE 1: MESHING
; ══════════════════════════════════════════════════════════════════════

; ── Initialize Watertight Geometry Workflow ───────────────────────────
(%py-exec "workflow.InitializeWorkflow(WorkflowType=r'Watertight Geometry')")

; ── 1. Import Geometry ───────────────────────────────────────────────
; OneZonePer='body' — robust default for 2025R1. 'label' is rejected
; ("Invalid Input label") and 'face' creates per-face zones that segfault
; Update Regions ("> invalid argument: not a number") on car-scale
; geometries. Discovery face labels survive as CAD face labels on the body;
; Update Boundaries below uses original_zones to map them to the SOP zone
; names (inlet / outlet / ground / symmetry / walls).
; NOTE: SaveFacetedFile was removed from CadImportOptions in 2025R1
;       ("Illegitimate input at /ImportGeometry/CadImportOptions").
(%py-exec "workflow.TaskObject['Import Geometry'].Arguments.set_state({'FileName': r'/scratch/<user>/autoansys/jobs/<full_car_job>/geometry.x_t', 'LengthUnit': r'mm', 'CadImportOptions': {'OneZonePer': r'body', 'FeatureAngle': 40.0, 'ExtractFeatures': r'yes'}, 'ImportCadPreferences': {'ShowImportCadPreferences': False, 'MaxFacetLength': 0}})")
(%py-exec "workflow.TaskObject['Import Geometry'].Execute()")

; ── 2. Add Local Sizing ──────────────────────────────────────────────
; SOP local-sizing categories: aero / chassis / wheels / intake
; SOP local-refinement regions:  nearfield / farfield / rear_wing

; ── 3. Generate Surface Mesh ─────────────────────────────────────────
; Reference journal (SOP): ExecuteShareTopology='No', DrawSizeControl=False,
; ScopeProximityTo='faces-and-edges', OriginalZones listed explicitly.
; The SOP CAD is exported from Discovery with the enclosure already built and
; faces labeled (inlet / outlet / ground / symmetry / walls / aero components),
; so Fluent does NOT need to cap or share-topology.
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Arguments.set_state({'CFDSurfaceMeshControls': {'DrawSizeControl': False, 'MinSize': 2.0, 'MaxSize': 264.0, 'GrowthRate': 1.2, 'CurvatureNormalAngle': 18.0, 'ScopeProximityTo': r'faces-and-edges'}, 'ExecuteShareTopology': r'No', 'OriginalZones': [r'inlet', r'outlet', r'ground', r'symmetry', r'walls']})")
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].Execute()")

; ── 3b. Improve Surface Mesh (SOP FaceQualityLimit 0.6, wall-zones scope) ─
; Improve Surface Mesh is NOT a built-in Watertight task — must be inserted
; after Generate Surface Mesh before TaskObject[...] can reference it.
(%py-exec "workflow.TaskObject['Generate the Surface Mesh'].InsertNextTask(CommandName='ImproveSurfaceMesh')")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Arguments.set_state({'FaceQualityLimit': 0.6, 'MeshObject': r'', 'SMImprovePreferences': {'AdvancedImprove': r'no', 'AllowDefeaturing': r'no', 'SIQualityCollapseLimit': 0.85, 'SIQualityIterations': 5, 'SIQualityMaxAngle': 160, 'SIRemoveStep': r'no', 'SIStepQualityLimit': 0, 'SIStepWidth': 0, 'ShowSMImprovePreferences': False}, 'SQMinSize': 2.0, 'ScopeImproveTo': r'wall-zones'})")
(%py-exec "workflow.TaskObject['Improve Surface Mesh'].Execute()")

; ── 4. Describe Geometry ─────────────────────────────────────────────
; Reference journal: defaults + UpdateChildTasks({v1: True}, SetupTypeChanged=False).
; The SOP CAD already contains the enclosure, so the default SetupType is correct
; and we do NOT override it here.
(%py-exec "workflow.TaskObject['Describe Geometry'].UpdateChildTasks(Arguments={'v1': True}, SetupTypeChanged=False)")
(%py-exec "workflow.TaskObject['Describe Geometry'].Execute()")

; ── 5. Update Boundaries ─────────────────────────────────────────────
; Reference: set_state(None) then Execute — picks up the Discovery-applied labels.
(%py-exec "workflow.TaskObject['Update Boundaries'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Boundaries'].Execute()")

; ── 6. Update Regions ────────────────────────────────────────────────
(%py-exec "workflow.TaskObject['Update Regions'].Arguments.set_state(None)")
(%py-exec "workflow.TaskObject['Update Regions'].Execute()")

; ── 7. Add Boundary Layers ──────────────────────────────────────────
; SOP: last-ratio offset method with Continuous local-prism preference.
; Setting OffsetMethodType='last-ratio' before AddChildAndUpdate makes the
; spawned child task be named 'last-ratio_1' (default would be 'smooth-transition_1').
(%py-exec "workflow.TaskObject['Add Boundary Layers'].Arguments.set_state({'LocalPrismPreferences': {'Continuous': r'Continuous'}, 'OffsetMethodType': r'last-ratio'})")
(%py-exec "workflow.TaskObject['Add Boundary Layers'].AddChildAndUpdate(DeferUpdate=False)")
(%py-exec "workflow.TaskObject['last-ratio_1'].Execute()")

; ── 8. Generate Volume Mesh ──────────────────────────────────────────
; Reference: no custom args, uses Watertight defaults.
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].Execute()")

; ── 8b. Improve Volume Mesh (SOP ortho-quality threshold 0.15) ───────
; Same pattern — must be inserted before reference.
(%py-exec "workflow.TaskObject['Generate the Volume Mesh'].InsertNextTask(CommandName='ImproveVolumeMesh')")
(%py-exec "workflow.TaskObject['Improve Volume Mesh'].Execute()")

; ══════════════════════════════════════════════════════════════════════
; TRANSITION: Switch from meshing mode to solver mode
; The mesh stays in memory — no file write/read needed
; ══════════════════════════════════════════════════════════════════════
switch-to-solution-mode
yes

; ══════════════════════════════════════════════════════════════════════
; PHASE 2: SOLVER SETUP
; ══════════════════════════════════════════════════════════════════════

; ── Print zone list for debugging ─────────────────────────────────────
; Zones come from Discovery-applied face labels on the Parasolid export.
; Expected: inlet, outlet, ground, symmetry, walls (+ aero components for full car).
(%py-exec "print('=== ZONE LIST ===')")
/define/boundary-conditions/list-zones

; ── Safety net: force enclosure cell zone to fluid ────────────────────
; If Discovery exported the enclosure as a solid body, flip it here.
; (If it's already fluid, Fluent will no-op or complain harmlessly.)
/define/boundary-conditions/zone-type enclosure fluid

; ── Reference values, turbulence model, all BCs (shared partial) ─────
; ════════════════════════════════════════════════════════════════════════
; SHARED BC + REFERENCE-VALUES BLOCK
; Included by both solver_from_case.jou.j2 (split workflow) and
; mesh_watertight.jou.j2 Phase 2 (combined workflow).
;
; Each BC list emits one Fluent TUI command per entry. The argument order
; mirrors the working specialist script (Max Squat full-car) byte-for-byte
; so reproducing it as a flat journal yields the same setup as the manual
; /define/boundary-conditions/... typing in the ARC command window.
; ════════════════════════════════════════════════════════════════════════

; ── Reference Values ──────────────────────────────────────────────────
; density is required for physical force COEFFICIENTS (AUDIT C4 — was unset).
/report/reference-values/area 0.65
/report/reference-values/length 2.8
/report/reference-values/velocity 15.65
/report/reference-values/density 1.225

; ── Turbulence Model ──────────────────────────────────────────────────
/define/models/viscous/kw-sst? yes
/define/models/viscous/curvature-correction? yes


; ── Velocity inlets ───────────────────────────────────────────────────
/define/boundary-conditions/velocity-inlet inlet no no yes yes no 15.65 no 0. no no yes 5.0 10.0

; ── Rotating walls (wheels) ──────────────────────────────────────────
; TUI: zone yes motion-bc-moving no no yes yes no no 0. no 0.5 no <ω> <ox> <oy> <oz> <ax> <ay> <az>
/define/boundary-conditions/zone-type front-tire wall
/define/boundary-conditions/wall front-tire yes motion-bc-moving no no yes yes no no 0. no 0.5 no 77.0 0.8264 0.6125 0.1998 0.0 1.0 0.0
/define/boundary-conditions/zone-type rear-tire wall
/define/boundary-conditions/wall rear-tire yes motion-bc-moving no no yes yes no no 0. no 0.5 no 77.0 -0.7056 0.6125 0.1998 0.0 1.0 0.0

; ── Translating walls (e.g. moving ground) ───────────────────────────
; TUI: zone yes motion-bc-moving no no yes no no <vel> <dx> <dy> <dz> no no 0. no 0.5
/define/boundary-conditions/zone-type ground wall
/define/boundary-conditions/wall ground yes motion-bc-moving no no yes no no 15.65 -1.0 0.0 0.0 no no 0. no 0.5

; ── Slip / specified-shear walls (tunnel walls, contact patches) ─────
; TUI: zone no yes shear-bc-spec-shear no no 0. no 0.5 no 0. no 0. no 0.
/define/boundary-conditions/zone-type tunnel-walls wall
/define/boundary-conditions/wall tunnel-walls no yes shear-bc-spec-shear no no 0. no 0.5 no 0. no 0. no 0.
/define/boundary-conditions/zone-type contact-patches wall
/define/boundary-conditions/wall contact-patches no yes shear-bc-spec-shear no no 0. no 0.5 no 0. no 0. no 0.

; ── Stationary no-slip walls ─────────────────────────────────────────
; Default Fluent wall behaviour; we just pin the zone-type explicitly.

; ── Pressure outlets ─────────────────────────────────────────────────

; ── Symmetry planes ──────────────────────────────────────────────────
/define/boundary-conditions/zone-type symmetry symmetry

; ── Solution Methods ──────────────────────────────────────────────────
/solve/set/p-v-coupling Coupled
/solve/set/gradient-scheme least-squares-cell-based
/solve/set/discretization-scheme/pressure second-order
/solve/set/discretization-scheme/mom second-order-upwind
/solve/set/discretization-scheme/k second-order-upwind
/solve/set/discretization-scheme/omega second-order-upwind

; ══════════════════════════════════════════════════════════════════════
; PHASE 3: SOLVER RUN
; ══════════════════════════════════════════════════════════════════════

; ── Report definitions, report files, convergence (shared partial) ───
; ════════════════════════════════════════════════════════════════════════
; SHARED REPORTS + CONVERGENCE BLOCK
; Included by solver_from_case.jou.j2 and mesh_watertight.jou.j2 so the two
; never diverge (a past divergence left the combined journal with undefined
; contour-surface variables — AUDIT C7).
;
; Forces/moment are integrated over the BODY wall zone(s) only, via
; reporting.body_wall_pattern — NOT the previous `thread-names *`, which also
; summed the moving ground and tunnel walls (AUDIT C3). Outputs are FORCES in
; Newtons (drag_force, lift_force, mom_y). The coefficients Cd/Cl/Cm and the
; half-model symmetry doubling are computed downstream in app/post/forces.py
; from these forces + the reference values, so the journal does not depend on
; the version-specific coefficient-report TUI.
; ════════════════════════════════════════════════════════════════════════


; ── Report Definitions (body-scoped forces; AUDIT C2/C3) ──────────────
/solve/report-definitions/add drag_force force force-vector 1 0 0 thread-names wall-body* () quit
/solve/report-definitions/add lift_force force force-vector 0 0 1 thread-names wall-body* () quit
/solve/report-definitions/add mom_y moment moment-vector 0 1 0 moment-center 0.0 0.0 0.0 thread-names wall-body* () quit

; ── Report Files ──────────────────────────────────────────────────────
/solve/report-files/add forces-report report-defs drag_force lift_force mom_y () file-name "/scratch/<user>/autoansys/jobs/<full_car_job>/forces.csv" print? yes quit
/solve/report-files/add residuals-report report-type iteration file-name "/scratch/<user>/autoansys/jobs/<full_car_job>/residuals.csv" print? yes quit

; ── Convergence Monitors ──────────────────────────────────────────────
/solve/monitors/residual/convergence-criteria 0.0001 0.0001 0.0001 0.0001 0.0001 0.0001
; Force-plateau convergence (AUDIT C5): stop early once the drag-force report
; settles. The fixed `/solve/iterate N` below remains the hard upper bound, so if
; this condition is mis-specified the run still terminates at N iterations.
; [needs-cluster] verify the /solve/convergence-conditions TUI arg order on 2025R1.
/solve/convergence-conditions/add drag-converged report-def drag_force stop-criterion 0.001 initial-values-to-ignore 187 previous-values-to-consider 100 print? yes () quit

; ── Initialize ────────────────────────────────────────────────────────
/solve/init/hyb-init

; ── Save case file before iterating (SOP step) ────────────────────────
/file/write-case "/scratch/<user>/autoansys/jobs/<full_car_job>/result.cas.h5"

; ── Run (SOP: individual part 300, full car 3000) ─────────────────────
/solve/iterate 750

; ── Export Results ────────────────────────────────────────────────────
/file/write-case-data "/scratch/<user>/autoansys/jobs/<full_car_job>/result.cas.h5"

; ══════════════════════════════════════════════════════════════════════
; PHASE 4: POST-PROCESSING — Contour Images (shared partial)
; ══════════════════════════════════════════════════════════════════════
; ════════════════════════════════════════════════════════════════════════
; SHARED CONTOUR / POST-PROCESSING BLOCK
; Included by solver_from_case.jou.j2 and mesh_watertight.jou.j2.
;
; The contour-surface zone names are derived here from the configured BCs, so
; both journals always have them defined. The combined journal previously
; referenced undefined  /  / 
; and rendered empty `surfaces  ()` selections (AUDIT C7).
; ════════════════════════════════════════════════════════════════════════


; ── Picture driver setup (offscreen PNG for batch mode) ───────────────
/display/set/picture/driver png
/display/set/picture/x-resolution 1920
/display/set/picture/y-resolution 1080
/display/set/picture/use-window-resolution no
/display/set/picture/color-mode color

; ── Mid-plane cross-section (Z=0) for flow-field views ────────────────
(%py-exec "solver.results.surfaces.iso_surface['midplane-z'] = {'field': 'z-coordinate', 'iso_values': [0.0]}")

/display/set/contours/filled? yes
/display/set/contours/node-values? yes

/display/set/contours/surfaces inlet outlet ground ()
/display/contour velocity velocity-magnitude
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_velocity.png"

/display/set/contours/surfaces midplane-z ()
/display/contour velocity velocity-magnitude
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_velocity_midplane.png"

/display/set/contours/surfaces inlet outlet ground ()
/display/contour pressure static-pressure
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_pressure.png"

/display/set/contours/surfaces midplane-z ()
/display/contour pressure static-pressure
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_pressure_midplane.png"

/display/set/contours/surfaces inlet outlet ground ()
/display/contour pressure total-pressure
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_total_pressure.png"

/display/set/contours/surfaces * ()
/display/contour pressure pressure-coefficient
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_cp.png"

/display/contour wall-fluxes wall-shear-stress
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_wall_shear.png"

/display/set/contours/surfaces midplane-z ()
/display/contour turb-kinetic-energy k
/display/save-picture "/scratch/<user>/autoansys/jobs/<full_car_job>/contour_tke_midplane.png"

; ── Done ──────────────────────────────────────────────────────────────
/exit yes

# Copy to `.env` and customize. Never commit real `.env` to git.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autoansys

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO (change all of these in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autoansys

# JWT — use a long random string in any shared or production deployment
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# HPC cluster — replace every placeholder with your site’s values
CLUSTER_HOST=cluster-login.example.edu
CLUSTER_PORT=22
CLUSTER_USER=your_netid
# Path inside the API container, or host path if running backend locally
CLUSTER_KEY_PATH=/root/.ssh/id_cluster
CLUSTER_WORKSPACE_BASE=/scratch/your_netid/autoansys/jobs
CLUSTER_ACCOUNT=your_slurm_account
# true = no real SSH (good for local UI dev); false = submit to CLUSTER_HOST
CLUSTER_MOCK_MODE=true

# ANSYS — module name as on your cluster (`module avail` / site docs)
FLUENT_MODULE=ANSYS/2025R1

# Job polling interval (seconds)
JOB_POLL_INTERVAL=30

# Docker Compose only: host path to SSH private key when mounting into backend/worker
# CLUSTER_SSH_KEY_HOST_PATH=/home/you/.ssh/id_ed25519
